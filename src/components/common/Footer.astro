    <!-- 中央: フッターリンク 2列 -->
    <div class="lg:col-span-3 grid grid-cols-2 gap-6 text-xs leading-loose text-brand-muted">
      <div class="space-y-1.5">
        <p class="text-brand-text font-semibold mb-2 border-b border-brand-border pb-1">Navigation</p>
        <p><a href="/" class="hover:text-brand-accent transition">トップページ</a></p>
        <p><a href="/concept/" class="hover:text-brand-accent transition">家づくりについて</a></p>
        <p><a href="/works/" class="hover:text-brand-accent transition">WORKS一覧</a></p>
        <p><a href="/owner-interview/" class="hover:text-brand-accent transition">オーナーインタビュー</a></p>
        <p><a href="/blog/" class="hover:text-brand-accent transition">ブログ</a></p>
      </div>
      <div class="space-y-1.5">
        <p class="text-brand-text font-semibold mb-2 border-b border-brand-border pb-1">Information</p>
