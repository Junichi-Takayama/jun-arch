        <a href="#" class="h-9 px-4 rounded-full border border-brand-border bg-white text-brand-text flex items-center justify-center gap-2 hover:border-brand-accent hover:text-brand-accent transition shadow-sm" aria-label="Instagram">
          <span class="font-bold">Instagram</span>
          <span class="text-[10px] text-brand-muted">@katojun0826</span>
        </a>
        <a href="#" class="h-9 px-4 rounded-full border border-brand-border bg-white text-brand-text flex items-center justify-center gap-2 hover:border-brand-accent hover:text-brand-accent transition shadow-sm" aria-label="note">
          <span class="font-bold">note</span>
          <span class="text-[10px] text-brand-muted">公式note</span>
        </a>
      </div>
