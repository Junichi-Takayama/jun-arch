---
interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;

const navItems = [
  { name: 'TOP', href: '/' },
  { name: 'NEWS', href: '/#news' },
  { name: '家づくりについて', href: '/concept/' },
  { name: 'WORKS一覧', href: '/works/' },
  { name: 'オーナーインタビュー', href: '/works/ua025/' },
  { name: 'CONTACT', href: '/contact/' },
];
---
<header class="bg-white/95 backdrop-blur-md border-b border-brand-border sticky top-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-3.5 flex flex-col md:flex-row md:items-center md:justify-between">
    <!-- Top Branding -->
    <div class="flex items-center justify-between w-full md:w-auto">
      <a href="/" class="flex flex-col group">
        <span class="text-[10px] tracking-[0.25em] text-brand-muted font-sans">技術の先にある、いごこちを</span>
        <span class="font-serif text-base md:text-lg tracking-[0.18em] font-medium text-brand-text group-hover:text-brand-accent transition-colors">
          株式会社 加藤淳設計事務所
        </span>
      </a>

      <!-- モバイルハンバーガーボタン -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-brand-text focus:outline-none"
        aria-label="メニューを開閉する"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- デスクトップナビゲーション -->
    <nav class="hidden md:flex items-center gap-7 text-xs tracking-wider uppercase font-medium text-brand-text">
      {
        navItems.map((item) => {
          const isActive = activePath === item.href || (item.href !== '/' && activePath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`py-1 transition-colors hover:text-brand-accent ${
                isActive ? 'text-brand-accent font-semibold border-b-2 border-brand-accent' : 'text-brand-muted'
              }`}
            >
              {item.name}
            </a>
          );
        })
      }
      <a
        href="/contact/"
        class="px-5 py-2.5 bg-brand-accent hover:bg-brand-dark text-white rounded font-medium transition duration-200 text-xs tracking-widest shadow-sm"
      >
        CONTACT
      </a>
    </nav>
  </div>

  <!-- モバイルドロワーメニュー -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-brand-border px-6 py-6 space-y-3">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="block py-2 border-b border-brand-border text-xs tracking-widest text-brand-text hover:text-brand-accent"
        >
          {item.name}
        </a>
      ))
    }
    <div class="pt-2">
      <a
        href="/contact/"
        class="block text-center py-3 bg-brand-accent hover:bg-brand-dark text-white text-xs tracking-widest font-bold shadow-sm rounded"
      >
        お問い合わせ・ご相談
      </a>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
    }
  });
</script>






