---
---
<header class="bg-stone-50/90 backdrop-blur-md border-b border-stone-200 sticky top-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 md:px-8 h-20 flex items-center justify-between">
    <!-- ロゴ枠 -->
    <a href="/" class="flex items-center gap-3 group">
      <img src="/images/logo.png" alt="加藤淳設計事務所" class="h-10 w-auto object-contain" />
      <div class="flex flex-col">
        <span class="font-serif-title text-base md:text-lg tracking-[0.15em] font-semibold text-stone-900 group-hover:text-amber-800 transition">加藤淳設計事務所</span>
        <span class="text-[9px] tracking-[0.25em] text-stone-500 font-sans">技術の先にある、いごこちを</span>
      </div>
    </a>

    <!-- デスクトップナビゲーション -->
    <nav class="hidden md:flex items-center gap-7 text-xs tracking-wider uppercase font-medium text-stone-700">
      <a href="/" class="hover:text-stone-950 transition duration-200">Home</a>
      <a href="/works/" class="hover:text-stone-950 transition duration-200">Works / 施工事例</a>
      <a href="/service/" class="hover:text-stone-950 transition duration-200">Concept / 家づくり</a>
      <a href="/company/" class="hover:text-stone-950 transition duration-200">About / 事務所概要</a>
      <a href="/news/" class="hover:text-stone-950 transition duration-200">News / お知らせ</a>
      <a href="/contact/" class="px-5 py-2.5 bg-stone-900 hover:bg-stone-800 text-stone-100 font-medium transition duration-200 text-xs tracking-widest shadow-sm hover:shadow">
        Contact / 無料相談
      </a>
    </nav>

    <!-- モバイルハンバーガーボタン -->
    <button id="mobile-menu-btn" class="md:hidden p-2 text-stone-800 focus:outline-none" aria-label="メニューを開く">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="hamburger-icon" class="transition-all duration-300" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- モバイルメニュー（ドロワーアニメーション） -->
  <div id="mobile-menu" class="hidden md:hidden bg-stone-50 border-b border-stone-200 px-6 py-6 transition-all duration-300 opacity-0 -translate-y-4">
    <nav class="flex flex-col gap-4 text-xs uppercase tracking-wider font-medium text-stone-800">
      <a href="/" class="py-2 border-b border-stone-200 hover:text-stone-500">Home / トップ</a>
      <a href="/works/" class="py-2 border-b border-stone-200 hover:text-stone-500">Works / 施工事例</a>
      <a href="/service/" class="py-2 border-b border-stone-200 hover:text-stone-500">Concept / 家づくりについて</a>
      <a href="/company/" class="py-2 border-b border-stone-200 hover:text-stone-500">About / 事務所概要</a>
      <a href="/news/" class="py-2 border-b border-stone-200 hover:text-stone-500">News / お知らせ</a>
      <a href="/contact/" class="mt-2 text-center py-3 bg-stone-900 text-white font-medium text-xs tracking-widest">
        Contact / 無料相談・お問い合わせ
      </a>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    let isOpen = false;

    if (btn && menu) {
      btn.addEventListener('click', () => {
        isOpen = !isOpen;
        if (isOpen) {
          menu.classList.remove('hidden');
          setTimeout(() => {
            menu.classList.remove('opacity-0', '-translate-y-4');
            menu.classList.add('opacity-100', 'translate-y-0');
          }, 10);
        } else {
          menu.classList.remove('opacity-100', 'translate-y-0');
          menu.classList.add('opacity-0', '-translate-y-4');
          setTimeout(() => {
            menu.classList.add('hidden');
          }, 300);
        }
      });
    }
  });
</script>




