---
interface Props {
  activePath?: string;
}

const currentPath = Astro.props.activePath ?? Astro.url.pathname;
const normalizedPath = currentPath.endsWith('/') && currentPath.length > 1 ? currentPath.slice(0, -1) : currentPath;

const conceptSubItems = [
  { name: '家づくりについて', href: '/concept/' },
  { name: '代表ごあいさつ', href: '/message/' },
  { name: '事務所概要', href: '/aboutus/' },
  { name: 'メディア掲載', href: '/media/' },
];

const blogSubItems = [
  { name: 'note', href: 'https://note.com/kato_arch', external: true },
  { name: '旧ブログ', href: 'https://junarch.exblog.jp/', external: true },
];

const contactSubItems = [
  { name: 'お問い合わせ・ご相談', href: '/contact/' },
  { name: '資料請求', href: '/contact/request/' },
  { name: 'プライバシーポリシー', href: '/privacy-policy/' },
];

const isHomeActive = normalizedPath === '' || normalizedPath === '/';
const isNewsActive = normalizedPath.startsWith('/news');
const isConceptActive = normalizedPath.startsWith('/concept') || normalizedPath.startsWith('/message') || normalizedPath.startsWith('/aboutus') || normalizedPath.startsWith('/media');
const isOwnerInterviewActive = normalizedPath.startsWith('/owner-interview');
const isWorksActive = normalizedPath.startsWith('/works');
const isQaActive = normalizedPath.startsWith('/qa');
const isContactActive = normalizedPath.startsWith('/contact') || normalizedPath.startsWith('/privacy-policy');
---

<header class="bg-white/95 backdrop-blur-md border-b border-brand-border sticky top-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-3.5 flex flex-col md:flex-row md:items-center md:justify-between">
    <!-- Top Branding -->
    <div class="flex items-center justify-between w-full md:w-auto">
      <h1 class="m-0 leading-none">
        <a href="/" class="flex flex-col group">
          <span class="text-[10px] tracking-[0.25em] text-brand-muted font-serif font-normal group-hover:text-brand-accent transition-colors">技術の先にある、いごこちを</span>
          <span class="font-serif text-base md:text-lg tracking-[0.18em] font-medium text-brand-text group-hover:text-brand-accent transition-colors">
            加藤淳設計事務所
          </span>
        </a>
      </h1>

      <!-- モバイルハンバーガーボタン -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-brand-text focus:outline-none"
        aria-label="メニューを開閉する"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- デスクトップナビゲーション -->
    <nav class="hidden md:flex items-center gap-4 lg:gap-6 text-xs tracking-wider uppercase font-medium text-brand-text">
      <a
        href="/"
        class={`py-1 transition-colors hover:text-brand-accent ${
          isHomeActive ? 'text-brand-accent font-semibold border-b-2 border-brand-accent' : 'text-brand-muted'
        }`}
      >
        TOP
      </a>

      <a
        href="/news/"
        class={`py-1 transition-colors hover:text-brand-accent ${
          isNewsActive ? 'text-brand-accent font-semibold border-b-2 border-brand-accent' : 'text-brand-muted'
        }`}
      >
        NEWS
      </a>

      <!-- 家づくりについて (ドロップダウン) -->
      <div class="relative group py-2">
        <a
          href="/concept/"
          class={`flex items-center gap-1 py-1 transition-colors hover:text-brand-accent ${
            isConceptActive ? 'text-brand-accent font-semibold border-b-2 border-brand-accent' : 'text-brand-muted'
          }`}
        >
          <span>家づくりについて</span>
          <svg class="w-3 h-3 text-brand-muted group-hover:text-brand-accent transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </a>

        <div class="absolute left-0 top-full hidden group-hover:block w-48 bg-white border border-brand-border shadow-lg rounded-sm py-2 z-50">
          {
            conceptSubItems.map((sub) => (
              <a
                href={sub.href}
                class="block px-4 py-2 text-xs tracking-wider text-brand-text hover:bg-brand-surface hover:text-brand-accent transition-colors"
              >
                {sub.name}
              </a>
            ))
          }
        </div>
      </div>

      <a
        href="/owner-interview/"
        class={`py-1 transition-colors hover:text-brand-accent ${
          isOwnerInterviewActive ? 'text-brand-accent font-semibold border-b-2 border-brand-accent' : 'text-brand-muted'
        }`}
      >
        オーナーインタビュー
      </a>

      <a
        href="/works/"
        class={`py-1 transition-colors hover:text-brand-accent ${
          isWorksActive ? 'text-brand-accent font-semibold border-b-2 border-brand-accent' : 'text-brand-muted'
        }`}
      >
        WORKS一覧
      </a>

      <!-- BLOG (ドロップダウン) -->
      <div class="relative group py-2">
        <span
          class="cursor-pointer flex items-center gap-1 py-1 transition-colors hover:text-brand-accent text-brand-muted"
        >
          <span>BLOG</span>
          <svg class="w-3 h-3 text-brand-muted group-hover:text-brand-accent transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </span>

        <div class="absolute left-0 top-full hidden group-hover:block w-36 bg-white border border-brand-border shadow-lg rounded-sm py-2 z-50">
          {
            blogSubItems.map((sub) => (
              <a
                href={sub.href}
                target={sub.external ? '_blank' : undefined}
                rel={sub.external ? 'noopener noreferrer' : undefined}
                class="block px-4 py-2 text-xs tracking-wider text-brand-text hover:bg-brand-surface hover:text-brand-accent transition-colors"
              >
                {sub.name}
              </a>
            ))
          }
        </div>
      </div>

      <a
        href="/qa/"
        class={`py-1 transition-colors hover:text-brand-accent ${
          isQaActive ? 'text-brand-accent font-semibold border-b-2 border-brand-accent' : 'text-brand-muted'
        }`}
      >
        Q&A
      </a>

      <!-- CONTACT (ドロップダウン) -->
      <div class="relative group py-2">
        <a
          href="/contact/"
          class={`flex items-center gap-1 py-1 transition-colors hover:text-brand-accent ${
            isContactActive ? 'text-brand-accent font-semibold border-b-2 border-brand-accent' : 'text-brand-muted'
          }`}
        >
          <span>CONTACT</span>
          <svg class="w-3 h-3 text-brand-muted group-hover:text-brand-accent transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </a>

        <div class="absolute right-0 top-full hidden group-hover:block w-48 bg-white border border-brand-border shadow-lg rounded-sm py-2 z-50">
          {
            contactSubItems.map((sub) => (
              <a
                href={sub.href}
                class="block px-4 py-2.5 text-xs tracking-wider text-brand-text hover:bg-brand-surface hover:text-brand-accent transition-colors"
              >
                {sub.name}
              </a>
            ))
          }
        </div>
      </div>
    </nav>
  </div>

  <!-- モバイルドロワーメニュー -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-brand-border px-6 py-4 space-y-2">
    <a href="/" class="block py-2 border-b border-brand-border text-xs tracking-widest text-brand-text hover:text-brand-accent">
      TOP
    </a>
    <a href="/news/" class="block py-2 border-b border-brand-border text-xs tracking-widest text-brand-text hover:text-brand-accent">
      NEWS
    </a>

    <!-- 家づくりについて & サブメニュー -->
    <div class="pt-1 border-b border-brand-border pb-2">
      <a href="/concept/" class="py-1 text-xs tracking-widest font-semibold text-brand-text block hover:text-brand-accent">
        家づくりについて
      </a>
      <div class="pl-4 space-y-1.5 mt-1">
        {
          conceptSubItems.map((sub) => (
            <a
              href={sub.href}
              class="block py-1 text-xs tracking-wider text-brand-muted hover:text-brand-accent"
            >
              ・ {sub.name}
            </a>
          ))
        }
      </div>
    </div>

    <a href="/owner-interview/" class="block py-2 border-b border-brand-border text-xs tracking-widest text-brand-text hover:text-brand-accent">
      オーナーインタビュー
    </a>
    <a href="/works/" class="block py-2 border-b border-brand-border text-xs tracking-widest text-brand-text hover:text-brand-accent">
      WORKS一覧
    </a>

    <!-- BLOG & サブメニュー -->
    <div class="pt-1 border-b border-brand-border pb-2">
      <div class="py-1 text-xs tracking-widest font-semibold text-brand-text">BLOG</div>
      <div class="pl-4 space-y-1.5 mt-1">
        {
          blogSubItems.map((sub) => (
            <a
              href={sub.href}
              target={sub.external ? '_blank' : undefined}
              rel={sub.external ? 'noopener noreferrer' : undefined}
              class="block py-1 text-xs tracking-wider text-brand-muted hover:text-brand-accent"
            >
              ・ {sub.name}
            </a>
          ))
        }
      </div>
    </div>

    <a href="/qa/" class="block py-2 border-b border-brand-border text-xs tracking-widest text-brand-text hover:text-brand-accent">
      Q&A
    </a>

    <!-- CONTACT & サブメニュー -->
    <div class="pt-1 border-b border-brand-border pb-2">
      <div class="py-1 text-xs tracking-widest font-semibold text-brand-text">CONTACT</div>
      <div class="pl-4 space-y-1.5 mt-1">
        {
          contactSubItems.map((sub) => (
            <a
              href={sub.href}
              class="block py-1 text-xs tracking-wider text-brand-muted hover:text-brand-accent"
            >
              ・ {sub.name}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
    }
  });
</script>






