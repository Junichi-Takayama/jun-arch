---
interface Props {
  eventTitle: string;
  eventDates: string[];
}

const { eventTitle, eventDates } = Astro.props;

const timeSlots = [
  '10:00', '10:30', '11:00', '11:30', '12:00', '12:30',
  '13:00', '13:30', '14:00', '14:30', '15:00', '15:30',
  '16:00', '16:30', '17:00', '17:30', '18:00'
];
---

<section id="reservation-form" class="mt-16 pt-12 border-t-2 border-brand-accent/30 bg-brand-surface/40 p-6 sm:p-10 rounded-sm">
  <div class="text-center mb-8">
    <span class="text-xs font-serif tracking-widest text-brand-accent uppercase block mb-1 font-semibold">Reservation</span>
    <h2 class="text-xl sm:text-2xl font-serif text-brand-text tracking-wider mb-2">完成見学会 ご予約フォーム</h2>
    <p class="text-xs text-brand-muted tracking-wider">完全予約制となっております。ご希望の日時を選択の上、送信してください。</p>
  </div>

  <form action="https://api.web3forms.com/submit" method="POST" class="space-y-6 max-w-xl mx-auto">
    <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
    <input type="hidden" name="subject" value={`【見学会予約】${eventTitle}`} />
    <input type="hidden" name="from_name" value="株式会社 加藤淳設計事務所" />
    <input type="hidden" name="redirect" value="https://jun-arch.pages.dev/contact/thanks/?type=event" />

    {eventDates.length > 0 && (
      <div>
        <label class="block text-xs font-medium tracking-wider text-brand-text mb-3">
          来場希望日 <span class="text-red-500 font-normal">※必須</span>
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {eventDates.map((d, idx) => (
            <label class="flex items-center gap-2 p-3 bg-white border border-brand-border rounded cursor-pointer hover:border-brand-accent transition-colors text-xs text-brand-text">
              <input type="radio" name="event_date" value={d} required={idx === 0} class="text-brand-accent focus:ring-brand-accent" />
              <span>{d}</span>
            </label>
          ))}
        </div>
      </div>
    )}

    <div>
      <label for="event_time" class="block text-xs font-medium tracking-wider text-brand-text mb-2">
        来場希望時間 <span class="text-red-500 font-normal">※必須</span>
      </label>
      <select id="event_time" name="event_time" required class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-white rounded-sm">
        <option value="">選択してください（10:00〜18:00）</option>
        {timeSlots.map((time) => (
          <option value={time}>{time}</option>
        ))}
      </select>
    </div>
  </form>
</section>

    <div>
      <label for="name" class="block text-xs font-medium tracking-wider text-brand-text mb-2">
        お名前 <span class="text-red-500 font-normal">※必須</span>
      </label>
      <input type="text" id="name" name="name" required placeholder="例：山田 太郎" class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-white rounded-sm" />
    </div>

    <div>
      <label for="name_kana" class="block text-xs font-medium tracking-wider text-brand-text mb-2">
        ふりがな <span class="text-red-500 font-normal">※必須</span>
      </label>
      <input type="text" id="name_kana" name="name_kana" required placeholder="例：やまだ たろう" class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-white rounded-sm" />
    </div>

    <div>
      <label for="tel" class="block text-xs font-medium tracking-wider text-brand-text mb-2">
        お電話番号 <span class="text-red-500 font-normal">※必須</span>
      </label>
      <input type="tel" id="tel" name="tel" required placeholder="例：090-0000-0000" class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-white rounded-sm" />
    </div>

    <div>
      <label for="email" class="block text-xs font-medium tracking-wider text-brand-text mb-2">
        Eメールアドレス <span class="text-red-500 font-normal">※必須</span>
      </label>
      <input type="email" id="email" name="email" required placeholder="例：name@example.com" class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-white rounded-sm" />
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="adults" class="block text-xs font-medium tracking-wider text-brand-text mb-2">大人</label>
        <select id="adults" name="adults" class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-white rounded-sm">
          <option value="1名">1名</option>
          <option value="2名" selected>2名</option>
          <option value="3名">3名</option>
          <option value="4名以上">4名以上</option>
        </select>
      </div>
      <div>
        <label for="children" class="block text-xs font-medium tracking-wider text-brand-text mb-2">お子様</label>
        <select id="children" name="children" class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-white rounded-sm">
          <option value="0名" selected>0名</option>
          <option value="1名">1名</option>
          <option value="2名">2名</option>
          <option value="3名以上">3名以上</option>
        </select>
      </div>
    </div>

    <div>
      <label for="address" class="block text-xs font-medium tracking-wider text-brand-text mb-2">
        ご住所（市区町村まで） <span class="text-red-500 font-normal">※必須</span>
      </label>
      <input type="text" id="address" name="address" required placeholder="例：新潟市中央区" class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-white rounded-sm" />
    </div>

    <div>
      <label for="message" class="block text-xs font-medium tracking-wider text-brand-text mb-2">ご質問・ご要望</label>
      <textarea id="message" name="message" rows="3" placeholder="土地探しについて相談したい等、ご自由にご記入ください。" class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-white rounded-sm"></textarea>
    </div>

    <div class="pt-2 text-center">
      <label class="inline-flex items-center gap-2 text-xs text-brand-muted cursor-pointer">
        <input type="checkbox" name="privacy_agreement" required class="text-brand-accent focus:ring-brand-accent rounded" />
        <span><a href="/privacy-policy/" target="_blank" class="underline hover:text-brand-accent">プライバシーポリシー</a>に同意の上、送信します</span>
      </label>
    </div>

    <div class="text-center pt-2">
      <button type="submit" class="w-full sm:w-auto sm:min-w-[280px] px-8 py-3.5 bg-brand-accent hover:opacity-95 text-white text-xs sm:text-sm tracking-widest rounded font-medium transition shadow-sm">
        見学会の予約を申し込む →
      </button>
    </div>