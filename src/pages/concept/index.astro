---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';

const breadcrumbs = [{ name: '家づくりについて' }];

// 住宅7原則データ
const principles = [
  {
    num: '01',
    title: '外観はシンプルに',
    image: '/images/concept/principle-01-simple-facade.jpg',
    alt: '01 外観はシンプルに'
  },
  {
    num: '02',
    title: '立体的に空間を繋ぐ',
    image: '/images/concept/principle-02-spatial-connection.png',
    alt: '02 立体的に空間を繋ぐ'
  },
  {
    num: '03',
    title: '内外の境界を曖昧に',
    image: '/images/concept/principle-03-indoor-outdoor.jpg',
    alt: '03 内外の境界を曖昧に'
  },
  {
    num: '04',
    title: '高窓で光を操る',
    image: '/images/concept/principle-04-high-window.jpg',
    alt: '04 高窓で光を操る'
  },
  {
    num: '05',
    title: '西日を活かす',
    image: '/images/concept/principle-05-west-sunlight.jpg',
    alt: '05 西日を活かす'
  },
  {
    num: '06',
    title: '引き戸で仕切る',
    image: '/images/concept/principle-06-sliding-doors.jpg',
    alt: '06 引き戸で仕切る'
  },
  {
    num: '07',
    title: '小さな書斎をつくる',
    image: '/images/concept/principle-07-small-den.jpg',
    alt: '07 小さな書斎をつくる'
  }
];

// 家づくりの流れ（7ステップ）
const flowSteps = [
  {
    step: '1',
    title: 'ご相談',
    desc: '土地が決まっていない状態でも大丈夫です。\n家へのイメージを具体的にするために、「設計カルテ」を書いていただいています。\nたくさんご希望を聞かせてください。\n「そこまでじゃなくて、まずは話だけ…」という方も歓迎です。'
  },
  {
    step: '2',
    title: '土地の決定',
    desc: 'ご希望の方には提携している不動産会社と協力し、土地探しからお手伝いします。\n下見に同行し、アドバイスをすることも可能です。'
  },
  {
    step: '3',
    title: '建物プラン(仮)',
    desc: 'ご希望を土地に合わせた初回プランを作成します。\nおおよそのお見積りもこの時にお渡しできます（決定ではありません）。\nプラン決定ではなく、予算・希望・生活の感覚に合わせてブラッシュアップしていきます。'
  },
  {
    step: '4',
    title: '設計契約',
    desc: '家づくりのパートナーとしてご信頼いただいたら、設計契約となります。\nここから詳細なお打合せのはじまりです。\n注文住宅はひとつひとつ全てを決めるので、大変ですが、楽しんでいきましょう。'
  },
  {
    step: '5',
    title: '工事開始',
    desc: '実際の工事に着手します。\n電気や内装など、工事と並行で確定する仕様を引き続きお打合せしていきます。\n工事が設計通りに行われているか、弊社がお客様の代理として監理にはいります。'
  },
  {
    step: '6',
    title: 'お引渡し',
    desc: 'ついに完成です！\n設備のご説明をさせていただき、新しい住まいのお引渡しとなります。'
  },
  {
    step: '7',
    title: 'アフターフォロー',
    desc: '安心して過ごしていただくために、定期点検もおこなっております。\n家の疑問やお困りごと、新たな夢があればいつでもご連絡ください。'
  }
];
---

<Layout
  title="家づくりについて – 加藤淳設計事務所"
  description="居心地のいい自然な美しさの住まいに暮らす楽しさ続く後悔しない家づくりをお約束します。２００棟以上の建築に携わった経験をもとに、合理的で心地よい空間を作り出すための独自の原則を設けています。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 pt-4 pb-20">
    <Breadcrumb items={breadcrumbs} />

    <!-- ページヘッダー -->
    <header class="text-center py-10 md:py-14 border-b border-brand-border">
      <span class="text-xs font-serif tracking-widest text-brand-accent uppercase block mb-2 font-semibold">Concept</span>
      <h1 class="text-2xl md:text-3xl font-serif tracking-wider text-brand-text">
        家づくりについて
      </h1>
    </header>

    <!-- メインビジュアル ＆ リード文 -->
    <section class="py-10 md:py-14 border-b border-brand-border">
      <div class="rounded-sm overflow-hidden border border-brand-border shadow-sm mb-8 bg-stone-100 max-w-[850px] mx-auto">
        <img
          src="/images/concept/concept-main.jpg"
          alt="家づくりについて"
          class="w-full h-auto object-cover"
          loading="eager"
        />
      </div>

      <div class="text-center max-w-2xl mx-auto space-y-6">
        <h2 class="text-xl md:text-2xl font-serif font-medium tracking-wide text-brand-text leading-relaxed">
          居心地のいい自然な美しさの住まいに暮らす<br />
          楽しさ続く後悔しない家づくりをお約束します
        </h2>

        <p class="text-xs sm:text-sm text-brand-text tracking-wider leading-relaxed">
          優れた建築のデザインとは見た目の良さはもちろん、<br class="hidden sm:inline" />
          そこで暮らす人の生活を便利に楽しくするものです。
        </p>

        <p class="text-xs sm:text-sm text-brand-text tracking-wider leading-relaxed">
          ２００棟以上の建築に携わった経験をもとに、<br class="hidden sm:inline" />
          合理的で心地よい空間を作り出すための独自の原則を設けています。
        </p>
      </div>
    </section>

    <!-- 住宅7原則 -->
    <section class="py-12 md:py-16 border-b border-brand-border">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-lg sm:text-xl md:text-2xl font-serif font-medium tracking-wider text-brand-text leading-relaxed">
          あなたのライフスタイル　住まいへの夢<br />
          <span class="text-brand-accent mx-1">×</span><br />
          加藤淳設計事務所が考える　住宅７原則
        </h2>
      </div>

      <!-- 住宅7原則 ギャラリー（3カラム×2段 ＋ 下段中央1カラム） -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-8 max-w-4xl mx-auto">
        {principles.map((item, index) => (
          <figure
            class={`flex flex-col ${
              index === 6
                ? 'sm:col-span-2 sm:max-w-xs sm:mx-auto md:col-start-2 md:col-span-1 md:max-w-none w-full'
                : 'w-full'
            }`}
          >
            <div class="aspect-[3/2] w-full overflow-hidden rounded-xs border border-brand-border/70 bg-stone-100">
              <img
                src={item.image}
                alt={item.alt}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <figcaption class="mt-3 text-center text-xs sm:text-sm font-serif font-medium text-brand-text tracking-wider">
              {item.num}　{item.title}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>


    <!-- 理想の家づくりのための３つのお約束 -->
    <section id="promise" class="py-12 md:py-16 border-b border-brand-border scroll-mt-20">
      <!-- バナー画像 -->
      <div class="rounded-sm overflow-hidden border border-brand-border mb-8 bg-stone-100 max-w-2xl mx-auto">
        <img
          src="/images/concept/promises-banner.png"
          alt="理想の家づくりのための３つのお約束"
          class="w-full h-auto object-cover"
          loading="lazy"
        />
      </div>

      <div class="text-center mb-12">
        <h2 class="text-xl md:text-2xl font-serif font-medium tracking-wider text-brand-text">
          理想の家づくりのための３つのお約束
        </h2>
      </div>

      <div class="space-y-16 max-w-2xl mx-auto">
        <!-- PROMISE 1 -->
        <div class="space-y-6">
          <h3 class="text-lg sm:text-xl font-serif font-medium text-brand-text tracking-wider">
            1.「耐震等級３」のデザイン住宅　家族と暮らしの安心の性能
          </h3>

          <p class="text-xs sm:text-sm text-brand-text tracking-wider leading-relaxed">
            私たちは、快適な住まいに必要な性能を、根拠を持って設計しています。<br />
            そこに暮らす人の健康と安全を守ることが、<strong class="text-brand-text font-medium">住まいの最大の役割</strong>と考えています。
          </p>

          <!-- 3枚の実例画像（3カラム並列） -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="rounded-xs overflow-hidden border border-brand-border bg-stone-100">
              <img
                src="/images/concept/promise-01-earthquake-resistance.png"
                alt="耐震等級3"
                class="w-full h-auto object-cover"
                loading="lazy"
              />
            </div>
            <div class="rounded-xs overflow-hidden border border-brand-border bg-stone-100">
              <img
                src="/images/concept/promise-01-heat-insulation.png"
                alt="断熱性能 HEAT20"
                class="w-full h-auto object-cover"
                loading="lazy"
              />
            </div>
            <div class="rounded-xs overflow-hidden border border-brand-border bg-stone-100">
              <img
                src="/images/concept/promise-01-airtightness.png"
                alt="気密性能 C値"
                class="w-full h-auto object-cover"
                loading="lazy"
              />
            </div>
          </div>

          <!-- 詳細解説 ＆ 保証 -->
          <div class="space-y-4 text-xs sm:text-sm text-brand-text leading-relaxed">
            <p>
              耐震等級３は建築基準法の1.5倍の強度。<br />
              消防署や警察署、防災の拠点となる建築など、学校や病院よりも厳しい耐震基準です。<br />
              私たちはこの耐震等級３にこだわります。<br />
              （詳しくは<a
                href="https://junarch.exblog.jp/30087885/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-accent underline hover:opacity-80 font-medium inline-flex items-center gap-0.5"
              >ブログ</a>でお伝えしています。）
            </p>

            <p>
              断熱基準HEAT20「G1」「G2」は、北海道水準の断熱・省エネ性能。
            </p>

            <p>
              気密性はC=0.5未満を目指しています。<br />
              この数値はもっと追求できますが、プランニングや工法によっても異なるため、景観や過ごしやすさも性能と考え、両立する数値として基準にしています。
            </p>

            <p class="text-brand-muted">
              また、お引き渡しから10年の間、工事に瑕疵があった場合の補修費用を補填するため、建設会社に加入が義務付けられている「瑕疵担保責任保険」に加えて、設備機器の保証や、最長60年の保証をおこなう「長期保証」に対応することも可能です。
            </p>
          </div>
        </div>


        <!-- PROMISE 2 -->
        <div id="promise2" class="space-y-6 scroll-mt-20">
          <div class="rounded-sm overflow-hidden border border-brand-border bg-stone-100">
            <img
              src="/images/concept/promise-02-long-lasting.png"
              alt="長く喜びが続く家"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>

          <h3 class="text-lg sm:text-xl font-serif font-medium text-brand-text tracking-wider">
            2.長く喜びが続く家
          </h3>

          <p class="text-xs sm:text-sm text-brand-text tracking-wider leading-relaxed">
            私たちのつくる住まいの「ピーク」は、新築完成時ではありません。
          </p>

          <ul class="space-y-2 text-xs sm:text-sm text-brand-text">
            <li class="flex items-start gap-2">
              <span class="text-brand-accent mt-0.5">・</span>
              <span>家族の成長や生活の変化に対応する<strong class="font-medium text-brand-text">フレキシブルな空間</strong></span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-brand-accent mt-0.5">・</span>
              <span><strong class="font-medium text-brand-text">古びていくのではなく、味が出る自然の素材</strong></span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-brand-accent mt-0.5">・</span>
              <span><strong class="font-medium text-brand-text">家事が楽に、楽しくなる</strong>家事導線や回遊性</span>
            </li>
          </ul>

          <p class="text-xs sm:text-sm text-brand-text tracking-wider leading-relaxed">
            暮らすほどに快適さが増す家を作ります。
          </p>

          <p class="text-xs sm:text-sm text-brand-text tracking-wider leading-relaxed">
            快適さをもたらすために、敷地や周辺の環境、採光や風の抜け、<strong class="text-brand-text font-medium">1日・1年の太陽の動きを確かめてプランニング。</strong><br />
            変形敷地や高低差も住まいの個性として活かします。
          </p>

          <div class="space-y-2 text-xs sm:text-sm text-brand-text leading-relaxed">
            <p>夏の暑さ、冬の寒さが辛くない。</p>
            <p>通年を通して自然な明るさの中で暮らせる。</p>
            <p>周りの建物の窓や目線に重ならない。</p>
            <p>理想の土地を予算を抑えてみつける可能性アップ。</p>
            <p class="text-brand-text">
              そんな「土地の魅力」を活かした家を作ります。
            </p>
          </div>
        </div>


        <!-- PROMISE 3 -->
        <div id="promise3" class="space-y-6 scroll-mt-20">
          <div class="rounded-sm overflow-hidden border border-brand-border bg-stone-100">
            <img
              src="/images/concept/promise-03-enjoyable-living.png"
              alt="一緒に楽しい家づくりをしましょう"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>

          <h3 class="text-lg sm:text-xl font-serif font-medium text-brand-text tracking-wider">
            3.一緒に楽しい家づくりをしましょう
          </h3>

          <div class="space-y-4 text-xs sm:text-sm text-brand-text tracking-wider leading-relaxed">
            <p>
              「注文住宅は、建築費用が高い…」と思われがち。<br />
              初期見積もりが高く、予算にあわせてどんどん希望を削ぎ落すのは憂鬱ですよね。<br />
              私自身、自宅を設計する時に痛感しました。
            </p>
            <p>
              だからこそ私たちは、<strong class="text-brand-text font-medium">家づくりの楽しさ</strong>を大切にしています。
            </p>
            <p>
              素材の工夫や現場との意見交換、予算のメリハリをつけてパズルのようにコストをコントロールして希望を実現していきます。
            </p>
          </div>

          <!-- コストコントロール図 -->
          <div class="rounded-sm overflow-hidden border border-brand-border bg-stone-100">
            <img
              src="/images/concept/promise-03-cost-control-diagram.png"
              alt="コストコントロール図"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <!-- 希望の「形」だけではなく「願い」を大切にします -->
      <div class="mt-16 pt-12 border-t border-brand-border max-w-2xl mx-auto space-y-6 text-center">
        <h2 class="text-base sm:text-lg md:text-xl font-serif font-medium text-brand-text tracking-wider">
          希望の「形」だけではなく「願い」を大切にします
        </h2>

        <div class="space-y-4 text-xs sm:text-sm text-brand-text tracking-wider leading-relaxed text-left sm:text-center">
          <p>
            例えば、大きな窓が欲しい、ウォークインクロゼットが欲しい…<br />
            それをただ組み立てていく「御用聞き」ではなく、
          </p>

          <p class="font-medium">
            「<strong class="text-brand-accent">どうして、あなたがそれを欲しいと思ったのか</strong>」を大切にしています。
          </p>

          <p class="pt-2">
            建てた後「思っていたのとちがう」という悲劇を防ぎお金のかかる夢や家族で意見が合わないことも、形にできる可能性が生まれていきます。
          </p>
        </div>
      </div>
    </section>

    <!-- 立体的な設計から生まれる、心地よい光と風 何気ない家時間を特別なくつろぎのひとときに -->
    <section class="py-12 md:py-16 border-b border-brand-border">
      <div class="max-w-3xl mx-auto">
        <!-- 空間イメージ写真 -->
        <div class="rounded-sm overflow-hidden border border-brand-border mb-8 bg-stone-100 max-w-2xl mx-auto">
          <img
            src="/images/concept/concept-spatial-comfort.jpg"
            alt="立体的な設計から生まれる、心地よい光と風"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
        </div>

        <h3 class="text-lg sm:text-xl md:text-2xl font-serif font-medium text-brand-text tracking-wide text-center leading-relaxed mb-8">
          立体的な設計から生まれる、心地よい光と風<br />
          <span class="text-brand-accent">何気ない家時間を特別なくつろぎのひとときに</span>
        </h3>

        <!-- チェックリスト 5項目 -->
        <div class="max-w-xl mx-auto mb-10">
          <ul class="space-y-3 text-xs sm:text-sm text-brand-text">
            <li class="flex items-start gap-2.5">
              <span class="text-brand-accent font-bold">✔</span>
              <span><strong class="font-medium text-brand-text">寒さ・暑さ・地震に強い家</strong>でずっと快適に暮らす</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-brand-accent font-bold">✔</span>
              <span>憧れや夢を予算だけで切り捨てない</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-brand-accent font-bold">✔</span>
              <span>美しく、それでいて<strong class="font-medium text-brand-text">くつろげる機能的なデザイン</strong></span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-brand-accent font-bold">✔</span>
              <span><strong class="font-medium text-brand-text">実践に基づく家事動線</strong>で、ストレスフリー</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-brand-accent font-bold">✔</span>
              <span>立体的なプランで、<strong class="font-medium text-brand-text">土地と家の魅力を最大化</strong></span>
            </li>
          </ul>
        </div>

        <div class="text-center max-w-2xl mx-auto space-y-4">
          <p class="text-xs sm:text-sm text-brand-text tracking-wider leading-relaxed">
            あなたがこんな家づくりをしたいと思われたなら加藤淳設計事務所にお任せください。
          </p>
          <p class="text-sm sm:text-base font-serif font-medium text-brand-text tracking-wider">
            初回プランは無料です。<br />
            ぜひ一度、あなたの夢を聞かせてください。
          </p>
          <div class="pt-4">
            <a
              href="/contact/"
              class="inline-block px-8 py-3.5 bg-brand-accent hover:bg-brand-dark text-white text-xs sm:text-sm tracking-wider rounded font-medium transition shadow-sm"
            >
              お気軽にお問い合わせください →
            </a>
          </div>
        </div>
      </div>
    </section>


    <!-- 家づくりの流れ -->
    <section id="flow" class="py-12 md:py-16 border-b border-brand-border scroll-mt-20">
      <!-- 家づくりの流れイメージ写真 -->
      <div class="rounded-sm overflow-hidden border border-brand-border shadow-sm mb-8 bg-stone-100 max-w-2xl mx-auto">
        <img
          src="/images/concept/workflow-heading-image.jpg"
          alt="家づくりの流れ"
          class="w-full h-auto object-cover"
          loading="lazy"
        />
      </div>

      <div class="text-center mb-12">
        <span class="text-xs font-serif tracking-widest text-brand-accent uppercase block mb-2 font-semibold">Workflow</span>
        <h2 class="text-xl md:text-2xl font-serif tracking-wider text-brand-text mb-4">
          家づくりの流れ
        </h2>
        <p class="text-xs sm:text-sm text-brand-text tracking-wider leading-relaxed max-w-2xl mx-auto">
          家づくりの流れは、実は人それぞれです。<br />
          先にご契約いただき一緒に土地を探すこともあれば、土地の契約前に仮プランをおつくりしてご契約いただくこともあります。<br />
          ここでは代表的な流れをご紹介します。
        </p>
      </div>

      <!-- 7ステップ タイムラインカード -->
      <div class="relative border-l-2 border-brand-border ml-4 sm:ml-8 pl-6 sm:pl-10 space-y-8">
        {flowSteps.map((item) => (
          <div class="relative group">
            <!-- タイムラインバッジ -->
            <div class="absolute -left-[35px] sm:-left-[51px] top-0 w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-white border-2 border-brand-accent flex items-center justify-center shadow-xs">
              <span class="text-[10px] sm:text-xs font-mono font-bold text-brand-accent">
                {item.step}
              </span>
            </div>

            <!-- ステップカード -->
            <div class="bg-white border border-brand-border rounded-sm p-5 sm:p-6 shadow-xs hover:shadow-sm transition">
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3 mb-2">
                <span class="text-xs font-mono font-semibold text-brand-accent tracking-widest">
                  STEP {item.step}
                </span>
                <h3 class="text-base sm:text-lg font-serif font-medium text-brand-text tracking-wide">
                  {item.title}
                </h3>
              </div>
              <p class="text-xs sm:text-sm text-brand-text tracking-wider leading-relaxed whitespace-pre-line">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- よくある質問リンク -->
      <div class="mt-14 pt-10 border-t border-brand-border text-center max-w-2xl mx-auto space-y-4">
        <div>
          <a
            href="/qa/"
            class="inline-block px-8 py-3.5 bg-stone-100 hover:bg-stone-200 border border-brand-border text-brand-text text-sm font-serif font-medium tracking-wider rounded transition shadow-xs"
          >
            よくある質問 →
          </a>
        </div>
        <p class="text-xs sm:text-sm text-brand-text tracking-wider leading-relaxed">
          よくあるご質問をまとめています。<br />
          あわせてご覧ください。
        </p>
      </div>
    </section>
  </div>
</Layout>

