---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import blogPosts from '../../data/blogPosts.json';

export function getStaticPaths() {
  const paths = [];
  for (const post of blogPosts) {
    paths.push({
      params: { slug: post.slug },
      props: { post }
    });
    if (post.decoded_slug && post.decoded_slug !== post.slug) {
      paths.push({
        params: { slug: post.decoded_slug },
        props: { post }
      });
    }
  }
  return paths;
}

const { post } = Astro.props;

const breadcrumbs = [
  { name: 'ブログ一覧', href: '/blog/' },
  { name: post.title }
];
---

<Layout title={`${post.title} – ブログ | 株式会社 加藤淳設計事務所`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 pt-4 pb-20">
    <Breadcrumb items={breadcrumbs} />

    <article class="max-w-3xl mx-auto mt-8">
      <!-- 記事ヘッダー -->
      <header class="border-b border-brand-border pb-6 mb-8">
        <div class="flex items-center gap-3 text-xs mb-3">
          <span class="text-brand-muted font-mono text-xs">{post.date}</span>
          <span class="px-2.5 py-0.5 bg-brand-light text-brand-dark rounded text-[11px] font-medium tracking-wider">
            {post.category}
          </span>
        </div>
        <h1 class="font-serif text-xl sm:text-2xl md:text-3xl font-medium text-brand-text leading-snug tracking-wide">
          {post.title}
        </h1>
      </header>

      <!-- アイキャッチ画像（存在する場合） -->
      {post.eyecatch && (
        <div class="mb-10 rounded-sm overflow-hidden border border-brand-border bg-stone-50">
          <img 
            src={post.eyecatch} 
            alt={post.title} 
            class="w-full max-h-[460px] object-cover"
          />
        </div>
      )}

      <!-- 記事本文（WordPress移植HTML） -->
      <div class="blog-body text-xs sm:text-sm text-brand-text leading-loose space-y-6">
        <div set:html={post.content} />
      </div>

      <!-- 転載・確認メモ（下部） -->
      <div class="mt-12 p-4 bg-brand-surface/60 border border-brand-border rounded-sm text-xs text-brand-muted space-y-1">
        <p class="font-semibold text-brand-text">※ 記事アーカイブ情報</p>
        <p>元URL: <a href={post.source_url} target="_blank" rel="noopener noreferrer" class="text-brand-accent hover:underline font-mono break-all">{post.source_url}</a></p>
      </div>

      <!-- 戻るボタン -->
      <div class="pt-10 mt-8 border-t border-brand-border text-center">
        <a
          href="/blog/"
          class="inline-block px-8 py-3 bg-brand-surface hover:bg-brand-light border border-brand-border text-brand-text text-xs tracking-widest rounded font-medium transition shadow-sm"
        >
          ← ブログ記事一覧に戻る
        </a>
      </div>
    </article>
  </div>
</Layout>

<style is:global>
  /* ブログ本文内のスタイル成形 */
  .blog-body p {
    margin-bottom: 1.5em;
    line-height: 2;
  }
  .blog-body h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2.5em;
    margin-bottom: 1em;
    padding-bottom: 0.5em;
    border-bottom: 1px solid #e5e5e5;
    color: #1e1e1e;
  }
  .blog-body h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 2em;
    margin-bottom: 0.75em;
    color: #1e1e1e;
  }
  .blog-body img {
    max-width: 100%;
    height: auto;
    border-radius: 2px;
    margin: 1.5em auto;
    display: block;
  }
  .blog-body figure {
    margin: 1.5em 0;
  }
  .blog-body figcaption {
    font-size: 0.75rem;
    color: #78716c;
    text-align: center;
    margin-top: 0.5em;
  }
  .blog-body a {
    color: #a16207;
    text-decoration: underline;
  }
  .blog-body a:hover {
    color: #854d0e;
  }
  .blog-body ul {
    list-style-type: disc;
    padding-left: 1.5em;
    margin-bottom: 1.5em;
  }
  .blog-body ol {
    list-style-type: decimal;
    padding-left: 1.5em;
    margin-bottom: 1.5em;
  }
  .blog-body blockquote {
    border-left: 3px solid #d6d3d1;
    padding-left: 1em;
    color: #57534e;
    margin: 1.5em 0;
    font-style: italic;
  }
</style>


