---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import blogPosts from '../../data/blogPosts.json';

const breadcrumbs = [{ name: 'ブログ一覧' }];

// 全21件の過去ブログ記事
---

<Layout title="ブログ – 株式会社 加藤淳設計事務所">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 pt-4 pb-20">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header -->
    <div class="text-center py-10 md:py-14 border-b border-brand-border mb-10">
      <span class="text-xs font-serif tracking-widest text-brand-accent uppercase block mb-2 font-semibold">Blog Archive</span>
      <h1 class="text-2xl md:text-3xl font-serif tracking-wider text-brand-text mb-4">
        ブログ記事一覧
      </h1>
      <p class="text-xs md:text-sm text-brand-muted tracking-wider">
        過去の設計日誌・コラム一覧（note転載・確認用アーカイブ）
      </p>
    </div>

    <!-- 記事一覧グリッド -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {blogPosts.map((post) => (
        <article class="flex flex-col justify-between group border border-brand-border bg-white rounded-sm overflow-hidden p-4 shadow-sm hover:border-brand-accent transition-colors">
          <div>
            <a href={`/blog/${post.slug}/`} class="aspect-[16/10] bg-brand-surface block overflow-hidden rounded-sm relative mb-3">
              {post.eyecatch ? (
                <img 
                  src={post.eyecatch} 
                  alt={post.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                  loading="lazy"
                />
              ) : (
                <img 
                  src="/images/noimage.png" 
                  alt={post.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                  loading="lazy"
                />
              )}
            </a>
            <div class="flex items-center gap-3 text-xs mb-2">
              <span class="text-brand-muted font-mono text-[11px]">{post.date}</span>
              <span class="px-2 py-0.5 bg-brand-light text-brand-dark rounded text-[10px] font-medium tracking-wider">
                {post.category}
              </span>
            </div>
            <h2 class="font-serif font-medium text-sm text-brand-text leading-snug group-hover:text-brand-accent transition">
              <a href={`/blog/${post.slug}/`}>
                {post.title}
              </a>
            </h2>
          </div>
          <div class="pt-4 mt-2 border-t border-brand-border/60 text-right">
            <a
              href={`/blog/${post.slug}/`}
              class="text-xs text-brand-accent group-hover:underline tracking-wider font-medium"
            >
              記事を読む →
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Back to Top CTA -->
    <div class="text-center pt-4">
      <a
        href="/"
        class="inline-block px-8 py-3 bg-brand-surface hover:bg-brand-light border border-brand-border text-brand-text text-xs tracking-widest rounded font-medium transition shadow-sm"
      >
        ← トップページに戻る
      </a>
    </div>
  </div>
</Layout>



