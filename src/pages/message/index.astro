---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';

const breadcrumbs = [
  { name: '家づくりについて', href: '/concept/' },
  { name: '代表ごあいさつ' }
];

const credentials = [
  '一級建築士',
  '管理建築士',
  '応急危険度判定士',
  '新潟県建築士会会員',
  '新潟市木造住宅耐震診断士'
];
---

<Layout title="代表ごあいさつ – 株式会社 加藤淳設計事務所">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 pt-4 pb-20">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header (h1) -->
    <div class="text-center py-10 md:py-14 border-b border-brand-border mb-12">
      <span class="text-xs font-serif tracking-widest text-brand-accent uppercase block mb-2 font-semibold">Message</span>
      <h1 class="text-2xl md:text-3xl font-serif tracking-wider text-brand-text mb-4">
        代表ごあいさつ
      </h1>
      <p class="text-xs md:text-sm text-brand-muted tracking-wider">
        技術の先にある、いごこちを。株式会社 加藤淳設計事務所 代表からのメッセージ
      </p>
    </div>

    <!-- メッセージ本文エリア -->
    <div class="bg-white border border-brand-border rounded-sm p-6 sm:p-10 md:p-12 mb-12 shadow-sm">
      <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-center md:items-start mb-8">
        <!-- 代表写真 -->
        <div class="shrink-0 text-center">
          <div class="w-44 h-44 rounded-sm overflow-hidden bg-stone-100 border border-brand-border shadow-sm mx-auto">
            <img
              src="https://jun-arch.com/wp-content/uploads/2020/07/b034989220140928190135.jpg"
              alt="加藤淳 代表取締役"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
          <p class="mt-3 font-serif font-medium text-sm text-brand-text">加藤 淳</p>
          <p class="text-[11px] text-brand-muted font-sans tracking-wider">Jun Kato</p>
        </div>

        <!-- メッセージ文章 -->
        <div class="flex-1 space-y-5 font-serif text-xs sm:text-sm text-brand-text leading-[2.3] tracking-[0.08em]">
          <p>
            住む人と土地を尊重して作られた家には、<br />
            家事を楽に、家族をより仲良く、生活をより楽しくする力があります。<br />
            だから私は小さな建物の中に、建築の基本や可能性が全てつまっている「住宅」が好きです。
          </p>
          <p>
            建築会社に勤めていたとき、自宅を建設したことをきっかけに<br />
            「会社のルールにとらわれず、本当に良いと思えるプランを作りたい」<br />
            「会社として利益がでる部分より、快適な住宅性能に予算を使いたい」<br />
            「この家に対するお客様の希望や声を、顔を見てお話したい」<br />
            そんな思いが強くなり、当事務所を設立しました。
          </p>
          <p>
            住宅・店舗・共同住宅・福祉施設など100棟以上。<br />
            設計・積算・監理など、様々な立場で建築に関わった経験をもとに、長く快適に、豊かに過ごせる家づくり、オーナー様にとっての「理想の住まい」のご提案に自信があります。
          </p>
          <p class="pt-2 text-right font-medium">
            加藤 淳　<span class="text-xs text-brand-muted font-sans font-normal">Kato Jun</span>
          </p>
        </div>
      </div>

      <!-- プロフィール詳細（h3 構造踏襲） -->
      <div class="border-t border-brand-border pt-8 mt-8 space-y-8">
        <!-- 来歴 -->
        <div>
          <h3 class="text-base sm:text-lg font-serif font-medium text-brand-text pb-2 border-b border-brand-border flex items-center gap-2 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span>
            来歴
          </h3>
          <div class="text-xs sm:text-sm text-brand-text leading-relaxed space-y-2 pl-2">
            <p><strong>1972年</strong>　埼玉県鴻巣市生まれ。南会津の設計事務所に12年間務める。</p>
            <p>
              <strong>2007年</strong>　青年海外協力隊に2年間参加。モンゴル国立科学技術大学建築学科で講師をしながら、
              <a
                href="http://jun0826.exblog.jp/tags/%E3%82%B2%E3%83%AB%E5%9C%B0%E5%8C%BA/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-accent hover:underline font-medium inline-flex items-center gap-0.5"
              >
                ゲル地区のゲル（モンゴルの伝統的住居）とセルフビルト住宅の住環境調査
                <span class="text-[10px]">↗</span>
              </a>
              を行う。
            </p>
            <p><strong>2010年</strong>　新潟市へ転居</p>
            <p><strong>2013年</strong>　自宅を設計</p>
            <p><strong>2015年</strong>　加藤淳一級建築士事務所 開設</p>
            <p><strong>2022年</strong>　株式会社 加藤淳設計事務所 法人化</p>
          </div>
        </div>

        <!-- 趣味 -->
        <div>
          <h3 class="text-base sm:text-lg font-serif font-medium text-brand-text pb-2 border-b border-brand-border flex items-center gap-2 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span>
            趣味
          </h3>
          <p class="text-xs sm:text-sm text-brand-text pl-2 leading-relaxed">
            建築、街散策、読書（歴史もの）、スノーボード（JSBA 1級）
          </p>
        </div>

        <!-- 資格 -->
        <div>
          <h3 class="text-base sm:text-lg font-serif font-medium text-brand-text pb-2 border-b border-brand-border flex items-center gap-2 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span>
            資格
          </h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs sm:text-sm text-brand-text pl-2">
            {
              credentials.map((item) => (
                <li class="flex items-center gap-2">
                  <span class="text-brand-accent">・</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- お問い合わせCTA -->
    <div class="text-center bg-brand-surface p-8 border border-brand-border rounded-sm">
      <p class="font-serif text-base text-brand-text font-medium mb-2">お気軽にお問い合わせください</p>
      <p class="text-xs text-brand-muted mb-6">家づくりのご相談、土地探し、リノベーションなど、どんなことでもお気軽にご連絡ください。</p>
      <a
        href="/contact/"
        class="inline-block px-10 py-3.5 bg-brand-accent hover:bg-brand-dark text-white font-bold text-xs tracking-widest rounded transition shadow-sm"
      >
        お問い合わせ・無料相談はこちら
      </a>
    </div>
  </div>
</Layout>

