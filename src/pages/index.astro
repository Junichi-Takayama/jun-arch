---
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/common/WorkCard.astro';
import { newsList, worksList, noteList, mediaList } from '../data/siteData';
---

<Layout title="株式会社 加藤淳設計事務所 – 技術の先にある、いごこちを">
  <!-- 1. Hero Main Visual (90vh) + キャッチコピー -->
  <section class="relative w-full h-[90vh] bg-stone-100 overflow-hidden">
    <img
      src="https://jun-arch.com/wp-content/uploads/2025/12/mv_01.jpg"
      alt="加藤淳設計事務所 メインビジュアル"
      class="w-full h-full object-cover object-center"
      loading="eager"
    />
    <!-- MV キャッチコピーオーバーレイ -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <div class="text-center px-4">
        <p class="text-white font-serif font-medium text-2xl sm:text-4xl md:text-5xl tracking-[0.2em] leading-[1.8] drop-shadow-[0_2px_8px_rgba(0,0,0,0.7)] [text-shadow:_0_2px_10px_rgba(0,0,0,0.75)]">
          その心地よさには、<br />理由がある
        </p>
      </div>
    </div>
  </section>

  <!-- 2. 導入文（ブランドステートメント） -->
  <section class="py-20 md:py-28 bg-white border-b border-brand-border text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="space-y-6 text-brand-text font-serif leading-[2.4] tracking-[0.16em] text-xs sm:text-sm md:text-base mb-12">
        <p>
          住み心地は、言葉にしにくい。<br />
          けれど人は、何より敏感に感じ取る。<br />
          私たちは、住まいの心地よさを<br />
          技術をつきつめた先にある、と考える。<br />
          暮らしを支える性能を、どこまでも追求する。<br />
          お客さまと対話を重ね、デザインに昇華する。<br />
          持ち得る技術をつくし切り、<br />
          その上で、技術だけではできないことを、<br />
          徹底的に考え抜く。<br />
          何気ない日常を、心地よくするために。<br />
          私たちは、目に見えにくいものにこそ、<br />
          目をむける家づくりを目指していく。
        </p>
        <p class="pt-4 font-medium">
          技術の先にある、いごこちを。<br />
          加藤淳設計事務所
        </p>
      </div>
      <div>
        <a
          href="/concept/"
          class="inline-block px-8 py-3 bg-[#ebebeb] hover:bg-stone-300 text-brand-text text-xs tracking-widest rounded-[10px] font-medium transition duration-200 shadow-sm"
        >
          <strong>家づくりについて</strong> →
        </a>
      </div>
    </div>
  </section>

  <!-- 3. NEWS Section (既存サイト直下レイアウト) -->
  <section id="news" class="py-16 md:py-20 bg-white border-b border-brand-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-brand-border">
        <h2 class="text-lg md:text-xl font-serif tracking-wider text-brand-text flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
          NEWS
        </h2>
        <a
          href="/news/"
          class="text-xs tracking-widest text-brand-muted hover:text-brand-accent transition-colors"
        >
          MORE →
        </a>
      </div>

      <div class="divide-y divide-brand-border">
        {
          newsList.map((item) => (
            <div class="py-4 flex flex-col md:flex-row md:items-center justify-between gap-2 group">
              <div class="flex items-center space-x-3">
                <span class="text-xs text-brand-muted tracking-wider font-mono">{item.date}</span>
                <span class="text-[10px] tracking-wider px-2 py-0.5 bg-brand-light text-brand-dark rounded">
                  {item.category}
                </span>
              </div>
              <a
                href={item.href}
                class="text-xs md:text-sm tracking-wider text-brand-text group-hover:text-brand-accent transition-colors flex-1 md:ml-4"
              >
                {item.title}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>


  <!-- 4. 外部コンテンツ動線: Instagram + Note（横並びひとかたまり） -->
  <section class="py-16 md:py-24 bg-white border-b border-brand-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- 左カラム: Instagram -->
        <div class="flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-brand-border mb-6">
              <h2 class="text-lg md:text-xl font-serif tracking-wider text-brand-text flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
                Instagram
              </h2>
              <a
                href="https://www.instagram.com/katojun0826/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-brand-accent tracking-widest hover:underline"
              >
                @katojun0826
              </a>
            </div>
            <!-- Instagram 6枚グリッド（3列×2行） -->
            <div class="grid grid-cols-3 gap-2.5 mb-6">
              {
                worksList.slice(0, 6).map((item) => (
                  <a
                    href="https://www.instagram.com/katojun0826/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="aspect-square overflow-hidden group block rounded-sm bg-stone-100"
                  >
                    <img
                      src={item.image}
                      alt={item.title}
                      loading="lazy"
                      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  </a>
                ))
              }
            </div>
          </div>
          <div class="text-center pt-2">
            <a
              href="https://www.instagram.com/katojun0826/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block px-8 py-2.5 bg-brand-surface border border-brand-border hover:border-brand-accent hover:text-brand-accent text-brand-text text-xs tracking-wider rounded font-medium transition shadow-sm"
            >
              Instagramを見る
            </a>
          </div>
        </div>

        <!-- 右カラム: 加藤淳設計事務所の備忘録（公式note） -->
        <div class="flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-brand-border mb-6">
              <h2 class="text-lg md:text-xl font-serif tracking-wider text-brand-text flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
                加藤淳設計事務所の備忘録
              </h2>
              <a
                href="https://note.com/kato_arch"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-brand-muted hover:text-brand-accent tracking-widest"
              >
                note →
              </a>
            </div>

            <!-- note記事リスト（カード形式） -->
            <div class="space-y-3 mb-6">
              {
                noteList.slice(0, 4).map((item) => (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex gap-3 p-2.5 bg-brand-surface border border-brand-border hover:border-brand-accent/50 rounded-sm transition"
                  >
                    <div class="w-20 h-16 shrink-0 overflow-hidden rounded-sm bg-stone-100">
                      <img
                        src={item.image}
                        alt={item.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                        loading="lazy"
                      />
                    </div>
                    <div class="flex-1 min-w-0 flex flex-col justify-between">
                      <span class="text-[10px] text-brand-muted font-mono">{item.date}</span>
                      <h4 class="text-xs text-brand-text group-hover:text-brand-accent line-clamp-2 leading-snug font-medium transition-colors">
                        {item.title}
                      </h4>
                    </div>
                  </a>
                ))
              }
            </div>
          </div>
          <div class="text-center pt-2">
            <a
              href="https://note.com/kato_arch"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block px-8 py-2.5 bg-brand-surface border border-brand-border hover:border-brand-accent hover:text-brand-accent text-brand-text text-xs tracking-wider rounded font-medium transition shadow-sm"
            >
              note記事一覧を見る
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. 家づくりについて（バナーリンク ＋ YouTube動画） -->
  <section class="py-16 md:py-20 bg-brand-surface border-b border-brand-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-brand-border">
        <h2 class="text-lg md:text-xl font-serif tracking-wider text-brand-text flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
          家づくりについて
        </h2>
        <a
          href="/concept/"
          class="text-xs tracking-widest text-brand-muted hover:text-brand-accent transition-colors"
        >
          MORE →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <!-- バナーリンク -->
        <div>
          <a
            href="https://daily-lives-niigata.com/2023/02/23/katojun/"
            target="_blank"
            rel="noopener noreferrer"
            class="block overflow-hidden rounded-sm shadow-sm hover:opacity-95 transition"
          >
            <img
              src="https://jun-arch.com/wp-content/uploads/2023/03/jun-arch_bnr-1-768x384.png"
              alt="会津、モンゴルを経て新潟へ。加藤淳の歩み"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </a>
        </div>

        <!-- YouTube動画 -->
        <div>
          <div class="aspect-video w-full overflow-hidden rounded-sm shadow-sm bg-black">
            <iframe
              class="w-full h-full"
              width="560"
              height="315"
              src="https://www.youtube.com/embed/FsXdF5Q1ufU?si=TzqEl7zomyd9C4LU"
              title="YouTube video player"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. オーナーインタビュー（3カラム外部リンクバナー配置） -->
  <section class="py-16 md:py-20 bg-white border-b border-brand-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-brand-border">
        <h2 class="text-lg md:text-xl font-serif tracking-wider text-brand-text flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
          オーナーインタビュー
        </h2>
        <a
          href="/works/ua025/"
          class="text-xs tracking-widest text-brand-muted hover:text-brand-accent transition-colors"
        >
          MORE →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- 1: E邸 -->
        <a
          href="/works/ua025/"
          class="block overflow-hidden rounded-sm shadow-sm hover:opacity-90 transition group"
        >
          <img
            src="https://jun-arch.com/wp-content/uploads/2026/10/banner-eg-house-768x512.png"
            alt="E邸 オーナーインタビュー"
            class="w-full h-auto object-cover group-hover:scale-[1.02] transition duration-300"
            loading="lazy"
          />
        </a>

        <!-- 2: シマトネリコの木 -->
        <a
          href="https://jun-arch.com/works/%e3%80%90%e5%8a%a0%e8%97%a4%e6%b7%b3%e8%a8%ad%e8%a8%88%e4%ba%8b%e5%8b%99%e6%89%80xag-%e5%b7%a5%e5%8b%99%e5%ba%97%e3%80%91%e3%82%b7%e3%83%9e%e3%83%88%e3%83%8d%e3%83%aa%e3%82%b3%e3%81%ae%e6%9c%a8/"
          target="_blank"
          rel="noopener noreferrer"
          class="block overflow-hidden rounded-sm shadow-sm hover:opacity-90 transition group"
        >
          <img
            src="https://jun-arch.com/wp-content/uploads/2026/10/banner-f-house-768x512.png"
            alt="シマトネリコの木 オーナーインタビュー"
            class="w-full h-auto object-cover group-hover:scale-[1.02] transition duration-300"
            loading="lazy"
          />
        </a>

        <!-- 3: W邸（日常新潟） -->
        <a
          href="https://daily-lives-niigata.com/2025/09/01/kato-ag-10/"
          target="_blank"
          rel="noopener noreferrer"
          class="block overflow-hidden rounded-sm shadow-sm hover:opacity-90 transition group"
        >
          <img
            src="https://jun-arch.com/wp-content/uploads/2026/10/banner-w-house-768x512.png"
            alt="W邸 オーナーインタビュー"
            class="w-full h-auto object-cover group-hover:scale-[1.02] transition duration-300"
            loading="lazy"
          />
        </a>
      </div>
    </div>
  </section>



  <!-- 6. WORKS（建築実例） -->
  <section class="py-16 md:py-24 bg-white border-b border-brand-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-10 pb-3 border-b border-brand-border">
        <h2 class="text-lg md:text-xl font-serif tracking-wider text-brand-text flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
          WORKS（建築実例）
        </h2>
        <a
          href="/works/"
          class="text-xs tracking-widest text-brand-muted hover:text-brand-accent transition-colors"
        >
          MORE WORKS →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          worksList.slice(0, 6).map((work) => (
            <WorkCard
              title={work.title}
              category={work.category}
              image={work.image}
              href={work.href}
              subtitle={work.subtitle}
              location={work.location}
            />
          ))
        }
      </div>

      <div class="mt-12 text-center">
        <a
          href="/works/"
          class="inline-block px-10 py-3 bg-brand-surface border border-brand-border hover:border-brand-accent hover:text-brand-accent text-brand-text text-xs tracking-wider rounded font-medium transition shadow-sm"
        >
          建築実例をもっと見る
        </a>
      </div>
    </div>
  </section>

  <!-- 7. メディア掲載履歴 -->
  <section class="py-16 bg-brand-surface">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-brand-border">
        <h2 class="text-lg md:text-xl font-serif tracking-wider text-brand-text flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
          メディア掲載履歴
        </h2>
        <a
          href="/media/"
          class="text-xs tracking-widest text-brand-muted hover:text-brand-accent transition-colors"
        >
          MORE →
        </a>
      </div>

      <div class="divide-y divide-brand-border bg-white border border-brand-border rounded-sm px-6">
        {
          mediaList.map((item) => (
            <div class="py-4 flex flex-col md:flex-row md:items-center justify-between gap-2 group">
              <div class="flex items-center space-x-3">
                <span class="text-xs text-brand-muted tracking-wider font-mono">{item.date}</span>
                <span class="text-[10px] tracking-wider px-2 py-0.5 bg-brand-surface text-brand-text rounded border border-brand-border">
                  {item.category}
                </span>
              </div>
              <a
                href={item.href}
                class="text-xs md:text-sm tracking-wider text-brand-text group-hover:text-brand-accent transition-colors flex-1 md:ml-4"
              >
                {item.title}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

