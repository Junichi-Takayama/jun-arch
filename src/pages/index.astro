---
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/common/WorkCard.astro';
import { newsList, worksList, noteList, mediaList } from '../data/siteData';
---

<Layout title="株式会社 加藤淳設計事務所 – 技術の先にある、いごこちを">
  <!-- 1. Hero Main Visual (90vh) -->
  <section class="relative w-full h-[90vh] bg-stone-100 overflow-hidden">
    <img
      src="https://jun-arch.com/wp-content/uploads/2025/12/mv_01.jpg"
      alt="加藤淳設計事務所 メインビジュアル"
      class="w-full h-full object-cover object-center"
      loading="eager"
    />
  </section>

  <!-- 2. NEWS Section (既存サイト直下レイアウト) -->
  <section id="news" class="py-16 md:py-20 bg-white border-b border-brand-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-brand-border">
        <h2 class="text-lg md:text-xl font-serif tracking-wider text-brand-text flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
          NEWS
        </h2>
        <a
          href="/news/"
          class="text-xs tracking-widest text-brand-muted hover:text-brand-accent transition-colors"
        >
          MORE →
        </a>
      </div>

      <div class="divide-y divide-brand-border">
        {
          newsList.map((item) => (
            <div class="py-4 flex flex-col md:flex-row md:items-center justify-between gap-2 group">
              <div class="flex items-center space-x-3">
                <span class="text-xs text-brand-muted tracking-wider font-mono">{item.date}</span>
                <span class="text-[10px] tracking-wider px-2 py-0.5 bg-brand-light text-brand-dark rounded">
                  {item.category}
                </span>
              </div>
              <a
                href={item.href}
                class="text-xs md:text-sm tracking-wider text-brand-text group-hover:text-brand-accent transition-colors flex-1 md:ml-4"
              >
                {item.title}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>


  <!-- 3. Instagram Feed Preview -->
  <section class="py-16 bg-brand-surface border-b border-brand-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-lg font-serif tracking-wider text-brand-text mb-2">Instagram</h2>
      <a
        href="https://www.instagram.com/katojun0826/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-brand-accent tracking-widest hover:underline block mb-8"
      >
        @katojun0826
      </a>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
        {
          worksList.slice(0, 6).map((item) => (
            <a
              href="https://www.instagram.com/katojun0826/"
              target="_blank"
              rel="noopener noreferrer"
              class="aspect-square overflow-hidden group block rounded-sm"
            >
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </a>
          ))
        }
      </div>
      <div class="mt-8">
        <a
          href="https://www.instagram.com/katojun0826/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-2.5 bg-white border border-brand-border hover:border-brand-accent hover:text-brand-accent text-brand-text text-xs tracking-wider rounded font-medium transition shadow-sm"
        >
          Instagramを見る
        </a>
      </div>
    </div>
  </section>

  <!-- 4. 家づくりについて ＆ 公式note（最新2カラム並列セクション） -->
  <section class="py-16 md:py-24 bg-white border-b border-brand-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
        <!-- 左カラム: 家づくりについて -->
        <div class="lg:col-span-5 flex flex-col justify-between">
          <div>
            <div class="pb-3 border-b border-brand-border mb-6">
              <h2 class="text-lg md:text-xl font-serif tracking-wider text-brand-text flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
                家づくりについて
              </h2>
            </div>
            <div class="aspect-[16/10] overflow-hidden rounded-sm mb-5 shadow-sm">
              <img
                src="https://jun-arch.com/wp-content/uploads/2026/10/Ehouse-02-1024x683.jpg"
                alt="加藤淳設計事務所の家づくり"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <h3 class="text-sm md:text-base font-serif tracking-wider text-brand-text font-medium mb-3">
              居心地のいい自然な美しさの住まいに暮らす
            </h3>
            <p class="text-xs text-brand-muted leading-relaxed tracking-wider mb-6">
              優れた建築のデザインとは、見た目の美しさはもちろん、そこで暮らす家族の生活を便利に楽しくするものです。耐震等級3、HEAT20 G1/G2、土地の恩恵を引き出す設計など、確かな技術で寄り添います。
            </p>
          </div>
          <div>
            <a
              href="/concept/"
              class="inline-block px-8 py-2.5 bg-brand-accent hover:bg-brand-dark text-white text-xs tracking-wider rounded font-medium transition shadow-sm"
            >
              家づくりについて詳しく →
            </a>
          </div>
        </div>
        <!-- 右カラム: 加藤淳設計事務所の備忘録（公式note） -->
        <div class="lg:col-span-7 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-brand-border mb-6">
              <h2 class="text-lg md:text-xl font-serif tracking-wider text-brand-text flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
                加藤淳設計事務所の備忘録（公式note）
              </h2>
              <a
                href="https://note.com/kato_arch"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-brand-muted hover:text-brand-accent tracking-widest"
              >
                note →
              </a>
            </div>

            <!-- noteカードグリッド 2列×3行 -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
              {
                noteList.map((item) => (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex gap-3 p-3 bg-brand-surface border border-brand-border hover:border-brand-accent/50 rounded-sm transition"
                  >
                    <div class="w-20 h-16 shrink-0 overflow-hidden rounded-sm bg-stone-100">
                      <img
                        src={item.image}
                        alt={item.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                        loading="lazy"
                      />
                    </div>
                    <div class="flex-1 min-w-0 flex flex-col justify-between">
                      <span class="text-[10px] text-brand-muted font-mono">{item.date}</span>
                      <h4 class="text-xs text-brand-text group-hover:text-brand-accent line-clamp-2 leading-snug font-medium transition-colors">
                        {item.title}
                      </h4>
                    </div>
                  </a>
                ))
              }
            </div>
          </div>
          <div>
            <a
              href="https://note.com/kato_arch"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block px-8 py-2.5 bg-white border border-brand-border hover:border-brand-accent hover:text-brand-accent text-brand-text text-xs tracking-wider rounded font-medium transition shadow-sm"
            >
              note記事一覧を見る
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. オーナーインタビュー ピックアップ -->
  <section class="py-16 md:py-20 bg-brand-surface border-b border-brand-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-brand-border">
        <h2 class="text-lg md:text-xl font-serif tracking-wider text-brand-text flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
          オーナーインタビュー
        </h2>
        <a
          href="/works/ua025/"
          class="text-xs tracking-widest text-brand-muted hover:text-brand-accent transition-colors"
        >
          MORE →
        </a>
      </div>

      <div class="bg-white border border-brand-border rounded-sm overflow-hidden shadow-sm grid grid-cols-1 md:grid-cols-12 gap-0">
        <div class="md:col-span-7 aspect-[16/10] overflow-hidden">
          <img
            src="https://jun-arch.com/wp-content/uploads/2026/10/Ehouse-02-1024x683.jpg"
            alt="E邸 オーナーインタビュー"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="md:col-span-5 p-6 md:p-8 flex flex-col justify-between">
          <div>
            <span class="text-[10px] tracking-widest px-2.5 py-0.5 bg-brand-light text-brand-dark rounded font-medium inline-block mb-3">
              コラボワークス × Ag-工務店
            </span>
            <h3 class="text-sm md:text-base font-serif font-medium text-brand-text leading-snug mb-3">
              心地いい暮らしのスタンダード。UA値0.25の断熱性能を備えた過不足のない住まい
            </h3>
            <p class="text-xs text-brand-muted leading-relaxed line-clamp-3">
              三方を住宅に囲まれた約40坪の台形敷地に、杉板張りの温もりとUA値0.25の圧倒的な断熱性能、フレキシブルなミニマル空間を両立した過不足のない住まい。
            </p>
          </div>
          <div class="pt-4">
            <a
              href="/works/ua025/"
              class="inline-block px-6 py-2.5 bg-brand-accent hover:bg-brand-dark text-white text-xs tracking-wider rounded font-medium transition shadow-sm"
            >
              記事を読む →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>



  <!-- 6. WORKS（建築実例） -->
  <section class="py-16 md:py-24 bg-white border-b border-brand-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-10 pb-3 border-b border-brand-border">
        <h2 class="text-lg md:text-xl font-serif tracking-wider text-brand-text flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
          WORKS（建築実例）
        </h2>
        <a
          href="/works/"
          class="text-xs tracking-widest text-brand-muted hover:text-brand-accent transition-colors"
        >
          MORE WORKS →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          worksList.slice(0, 6).map((work) => (
            <WorkCard
              title={work.title}
              category={work.category}
              image={work.image}
              href={work.href}
              subtitle={work.subtitle}
              location={work.location}
            />
          ))
        }
      </div>

      <div class="mt-12 text-center">
        <a
          href="/works/"
          class="inline-block px-10 py-3 bg-brand-surface border border-brand-border hover:border-brand-accent hover:text-brand-accent text-brand-text text-xs tracking-wider rounded font-medium transition shadow-sm"
        >
          建築実例をもっと見る
        </a>
      </div>
    </div>
  </section>

  <!-- 7. メディア掲載履歴 -->
  <section class="py-16 bg-brand-surface">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-8 pb-3 border-b border-brand-border">
        <h2 class="text-lg md:text-xl font-serif tracking-wider text-brand-text flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-brand-accent"></span>
          メディア掲載履歴
        </h2>
        <a
          href="/media/"
          class="text-xs tracking-widest text-brand-muted hover:text-brand-accent transition-colors"
        >
          MORE →
        </a>
      </div>

      <div class="divide-y divide-brand-border bg-white border border-brand-border rounded-sm px-6">
        {
          mediaList.map((item) => (
            <div class="py-4 flex flex-col md:flex-row md:items-center justify-between gap-2 group">
              <div class="flex items-center space-x-3">
                <span class="text-xs text-brand-muted tracking-wider font-mono">{item.date}</span>
                <span class="text-[10px] tracking-wider px-2 py-0.5 bg-brand-surface text-brand-text rounded border border-brand-border">
                  {item.category}
                </span>
              </div>
              <a
                href={item.href}
                class="text-xs md:text-sm tracking-wider text-brand-text group-hover:text-brand-accent transition-colors flex-1 md:ml-4"
              >
                {item.title}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

