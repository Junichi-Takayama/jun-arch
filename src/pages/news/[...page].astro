---
import type { GetStaticPathsOptions, Page } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import Pagination from '../../components/common/Pagination.astro';
import { getNewsList, type NewsItem } from '../../lib/microcms';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allNews = await getNewsList();
  return paginate(allNews, { pageSize: 10 });
}

interface Props {
  page: Page<NewsItem>;
}

const { page } = Astro.props;

const breadcrumbs = [
  { name: 'お知らせ・見学会', ...(page.currentPage > 1 ? { href: '/news/' } : {}) },
  ...(page.currentPage > 1 ? [{ name: `${page.currentPage}ページ目` }] : []),
];
---

<Layout title={`お知らせ・見学会（NEWS）${page.currentPage > 1 ? ` (${page.currentPage}ページ目)` : ''} – 株式会社 加藤淳設計事務所`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 pt-4 pb-20">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header -->
    <div class="text-center py-10 md:py-14 border-b border-brand-border mb-10">
      <span class="text-xs font-serif tracking-widest text-brand-accent uppercase block mb-2 font-semibold">Information & Event</span>
      <h1 class="text-2xl md:text-3xl font-serif tracking-wider text-brand-text mb-4">
        NEWS（お知らせ・見学会）
      </h1>
      <p class="text-xs md:text-sm text-brand-muted tracking-wider">
        加藤淳設計事務所の最新情報、見学会（オープンハウス）の開催案内をお届けします。
      </p>
    </div>

    <!-- News List -->
    <div class="border-t border-b border-brand-border divide-y divide-brand-border mb-8 bg-white">
      {
        page.data.map((item) => (
          <div class="py-5 px-3 sm:px-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 group hover:bg-brand-surface/60 transition-colors">
            {/* 日付＆カテゴリ固定幅コンテナ（タイトルの開始位置を一直線に完全同期） */}
            <div class="flex items-center space-x-3 shrink-0">
              <span class="text-xs text-brand-muted tracking-wider font-mono w-24 shrink-0">{item.date}</span>
              <span class="text-[10px] tracking-wider py-0.5 bg-brand-light text-brand-dark rounded border border-brand-border/60 w-36 text-center shrink-0 block">
                {item.category}
              </span>
            </div>
            {/* タイトルリンク */}
            <a
              href={`/news/${item.id}/`}
              class="text-xs md:text-sm tracking-wider text-brand-text group-hover:text-brand-accent transition-colors flex-1 sm:ml-4 font-medium"
            >
              {item.title}
            </a>
          </div>
        ))
      }
    </div>

    <!-- ページネーション（ページャー） -->
    <Pagination page={page} />

    <!-- Back to Top CTA -->
    <div class="text-center pt-4">
      <a
        href="/"
        class="inline-block px-8 py-3 bg-brand-surface hover:bg-brand-light border border-brand-border text-brand-text text-xs tracking-widest rounded font-medium transition shadow-sm"
      >
        ← トップページに戻る
      </a>
    </div>
  </div>
</Layout>
