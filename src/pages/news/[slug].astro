---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getNewsList, getNewsDetail } from '../../lib/microcms';

export async function getStaticPaths() {
  const newsList = await getNewsList();
  return newsList.map((item) => ({
    params: { slug: item.id },
  }));
}

const { slug } = Astro.params;
const news = await getNewsDetail(slug as string);

if (!news) {
  return Astro.redirect('/news/');
}

const breadcrumbs = [
  { name: 'お知らせ・見学会', href: '/news/' },
  { name: news.title },
];
---

<Layout title={`${news.title} – 株式会社 加藤淳設計事務所`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-4 pb-20">
    <Breadcrumb items={breadcrumbs} />

    <!-- Article Header -->
    <article class="max-w-3xl mx-auto pt-6 pb-12">
      <header class="border-b border-brand-border pb-6 mb-8 space-y-4">
        <div class="flex items-center gap-3 text-xs">
          <span class="text-brand-muted font-mono tracking-wider">{news.date}</span>
          <span class="px-2.5 py-0.5 bg-brand-light text-brand-dark text-[10px] tracking-wider font-medium rounded border border-brand-border/60">
            {news.category}
          </span>
        </div>
        <h1 class="text-xl sm:text-2xl md:text-3xl font-serif font-medium text-brand-text leading-snug tracking-wider">
          {news.title}
        </h1>
      </header>

      <!-- Thumbnail -->
      {
        news.thumbnail && (
          <div class="aspect-[16/9] sm:aspect-[21/9] overflow-hidden rounded-sm bg-brand-surface mb-8 border border-brand-border">
            <img
              src={news.thumbnail.url}
              alt={news.title}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        )
      }

      <!-- Body Content -->
      <div
        class="news-content text-xs sm:text-sm text-brand-text leading-[2.2] tracking-wider space-y-6 font-light"
        set:html={news.content}
      />

      <!-- Action Navigation -->
      <div class="pt-12 mt-12 border-t border-brand-border flex flex-col sm:flex-row justify-between items-center gap-4">
        <a
          href="/news/"
          class="inline-flex items-center gap-2 px-6 py-2.5 bg-brand-surface hover:bg-brand-light border border-brand-border text-brand-text text-xs tracking-wider rounded font-medium transition shadow-sm w-full sm:w-auto justify-center"
        >
          <span>←</span>
          <span>お知らせ一覧に戻る</span>
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 px-6 py-2.5 bg-brand-accent hover:opacity-95 text-white text-xs tracking-wider rounded font-medium transition shadow-sm w-full sm:w-auto justify-center"
        >
          <span>家づくりのご相談・見学予約はこちら</span>
          <span>→</span>
        </a>
      </div>
    </article>
  </div>
</Layout>

<style is:global>
  .news-content p {
    margin-bottom: 1.5rem;
  }
  .news-content h2,
  .news-content h3,
  .news-content h4 {
    font-family: inherit;
    font-weight: 600;
    color: #333333;
    letter-spacing: 0.05em;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .news-content h2 {
    font-size: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #eeeeee;
  }
  .news-content h3 {
    font-size: 1.1rem;
  }
  .news-content img {
    max-width: 100%;
    height: auto;
    border-radius: 2px;
    margin: 1.5rem 0;
  }
  .news-content a {
    color: #dd9933;
    text-decoration: underline;
    transition: opacity 0.2s;
  }
  .news-content a:hover {
    opacity: 0.8;
  }
</style>



