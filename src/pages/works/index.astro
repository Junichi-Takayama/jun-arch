---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import WorkCard from '../../components/common/WorkCard.astro';
import { worksList } from '../../data/siteData';

const breadcrumbs = [{ name: 'WORKS一覧' }];

const categories = ['すべて', '新築', 'リノベーション', 'コラボワークス', 'オーナーインタビュー'];
---

<Layout title="WORKS（建築実例一覧） – 株式会社 加藤淳設計事務所">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-4 pb-20">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header -->
    <div class="text-center py-10 md:py-14 border-b border-brand-border mb-8">
      <span class="text-xs font-serif tracking-widest text-brand-accent uppercase block mb-2 font-semibold">Portfolio</span>
      <h1 class="text-2xl md:text-3xl font-serif tracking-wider text-brand-text mb-4">
        WORKS（建築実例）
      </h1>
      <p class="text-xs md:text-sm text-brand-muted tracking-wider">
        「技術の先にある、いごこちを。」を追求した加藤淳設計事務所の建築実績です。
      </p>
    </div>

    <!-- Category Tabs -->
    <div class="flex items-center justify-center flex-wrap gap-2 pb-8 border-b border-brand-border mb-10">
      {
        categories.map((cat, idx) => (
          <button
            type="button"
            class={`px-4 py-2 text-xs tracking-widest transition-colors rounded-sm ${
              idx === 0
                ? 'bg-brand-accent text-white font-medium shadow-sm'
                : 'bg-brand-surface text-brand-text hover:bg-brand-light/40 border border-brand-border'
            }`}
          >
            {cat}
          </button>
        ))
      }
    </div>

    <!-- Works Grid: 3-Columns -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        worksList.map((work) => (
          <WorkCard
            title={work.title}
            category={work.category}
            image={work.image}
            href={work.href}
            subtitle={work.subtitle}
            location={work.location}
          />
        ))
      }
    </div>

    <!-- Pagination -->
    <div class="mt-16 pt-8 border-t border-brand-border flex justify-center items-center space-x-2">
      <span class="w-9 h-9 flex items-center justify-center bg-brand-accent text-white text-xs font-mono rounded-sm">
        1
      </span>
      <a
        href="#"
        class="w-9 h-9 flex items-center justify-center bg-brand-surface hover:bg-brand-light/30 border border-brand-border text-brand-text text-xs font-mono transition-colors rounded-sm"
      >
        2
      </a>
      <a
        href="#"
        class="px-3 h-9 flex items-center justify-center bg-brand-surface hover:bg-brand-light/30 border border-brand-border text-brand-text text-xs tracking-wider transition-colors rounded-sm"
      >
        NEXT →
      </a>
    </div>
  </div>
</Layout>

