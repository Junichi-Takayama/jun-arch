---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { flowSteps } from '../data/siteData';

const breadcrumbs = [{ name: '家づくりについて' }];
---

<Layout title="家づくりについて – 株式会社 加藤淳設計事務所">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-4 pb-20">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header -->
    <div class="text-center py-12 md:py-16 border-b border-brand-border">
      <span class="text-xs font-serif tracking-widest text-brand-accent uppercase block mb-3 font-semibold">Concept</span>
      <h1 class="text-2xl md:text-3xl font-serif tracking-wider text-brand-text mb-6">
        加藤淳設計事務所の家づくり
      </h1>
      <p class="text-sm md:text-base font-serif text-brand-text tracking-widest leading-relaxed">
        居心地のいい自然な美しさの住まいに暮らす。<br class="hidden sm:inline" />
        楽しさ続く後悔しない家づくりをお約束します。
      </p>
    </div>

    <!-- Intro Statement -->
    <div class="py-12 text-center max-w-2xl mx-auto">
      <h2 class="text-base font-serif tracking-wider text-brand-text mb-4">優れた建築のデザインとは</h2>
      <p class="text-xs md:text-sm text-brand-muted tracking-wider leading-relaxed">
        見た目の良さはもちろん、そこで暮らす家族の生活を便利に楽しくするものです。<br />
        100棟以上の建築に携わった経験をもとに、合理的で心地よい空間を作り出す独自の原則を設けています。
      </p>
    </div>

    <!-- 3 Promises Section -->
    <div class="space-y-12 py-6">
      <!-- Promise 1 -->
      <div class="bg-brand-surface p-6 md:p-8 border border-brand-border rounded-sm">
        <span class="text-xs font-mono tracking-widest text-brand-accent block mb-1 font-semibold">PROMISE 01</span>
        <h3 class="text-lg font-serif tracking-wider text-brand-text mb-3">
          耐震等級3のデザイン住宅。家族と暮らしの安心性能
        </h3>
        <p class="text-xs md:text-sm text-brand-muted tracking-wider leading-relaxed mb-6">
          加藤淳設計事務所では、快適な住まいに必要な性能を根拠をもって設計。家族の健康と安全を守ることが住まいの最大の役割と考えています。
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 border-t border-brand-border pt-5">
          <div class="bg-white p-4 text-center border border-brand-border rounded-sm">
            <span class="text-xs text-brand-muted block mb-1">耐震性能</span>
            <span class="text-base font-serif text-brand-text font-medium">耐震等級 3</span>
            <span class="text-[10px] text-brand-muted block mt-1">基準法の1.5倍の強度</span>
          </div>
          <div class="bg-white p-4 text-center border border-brand-border rounded-sm">
            <span class="text-xs text-brand-muted block mb-1">断熱性能</span>
            <span class="text-base font-serif text-brand-text font-medium">HEAT20 G1/G2</span>
            <span class="text-[10px] text-brand-muted block mt-1">北海道水準の省エネ</span>
          </div>
          <div class="bg-white p-4 text-center border border-brand-border rounded-sm">
            <span class="text-xs text-brand-muted block mb-1">気密性能</span>
            <span class="text-base font-serif text-brand-text font-medium">C値 0.5 未満</span>
            <span class="text-[10px] text-brand-muted block mt-1">過ごしやすさと両立</span>
          </div>
        </div>
      </div>

      <!-- Promise 2 -->
      <div class="bg-brand-surface p-6 md:p-8 border border-brand-border rounded-sm">
        <span class="text-xs font-mono tracking-widest text-brand-accent block mb-1 font-semibold">PROMISE 02</span>
        <h3 class="text-lg font-serif tracking-wider text-brand-text mb-3">
          長く喜びが続く家
        </h3>
        <p class="text-xs md:text-sm text-brand-muted tracking-wider leading-relaxed mb-4">
          私たちのつくる「住まいのピーク」は新築完成時ではありません。家族の成長に対応するフレキシブル空間、経年美化する自然素材、スムーズな家事動線で暮らすほどに快適さが増す家を作ります。
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-brand-text bg-white p-4 border border-brand-border rounded-sm">
          <div>✔ 夏の暑さ・冬の寒さが辛くない</div>
          <div>✔ 通年で自然な明るさの中で暮らせる</div>
          <div>✔ 周囲の視線に重ならない立体配置</div>
          <div>✔ 土地の魅力を最大限に活かす設計</div>
        </div>
      </div>

      <!-- Promise 3 -->
      <div class="bg-brand-surface p-6 md:p-8 border border-brand-border rounded-sm">
        <span class="text-xs font-mono tracking-widest text-brand-accent block mb-1 font-semibold">PROMISE 03</span>
        <h3 class="text-lg font-serif tracking-wider text-brand-text mb-3">
          一緒に楽しい家づくりをしましょう
        </h3>
        <p class="text-xs md:text-sm text-brand-muted tracking-wider leading-relaxed mb-4">
          「注文住宅は費用が高い…」と予算に合わせて希望を削ぎ落とすのは憂鬱ですよね。素材の工夫や予算のメリハリをつけ、パズルのようにコストコントロールをして希望を実現します。
        </p>
        <div class="border-l-2 border-brand-accent pl-4 py-1">
          <h4 class="text-xs font-serif text-brand-text tracking-wider font-semibold">希望の「形」だけでなく「願い」を大切に</h4>
          <p class="text-xs text-brand-muted tracking-wider mt-1">
            「大きな窓が欲しい」をただ形にするのではなく、「どうしてそれを欲しいと思ったのか」を対話から引き出します。
          </p>
        </div>
      </div>
    </div>

    <!-- Workflow Steps -->
    <div class="pt-14 pb-8">
      <div class="text-center mb-10 pb-3 border-b border-brand-border">
        <span class="text-xs font-serif tracking-widest text-brand-accent uppercase block mb-1 font-semibold">Flow</span>
        <h2 class="text-xl font-serif tracking-wider text-brand-text">家づくりの流れ</h2>
        <p class="text-xs text-brand-muted tracking-wider mt-2">代表的な7つのステップをご紹介します。</p>
      </div>
      <div class="divide-y divide-brand-border">
        {flowSteps.map((item) => (
          <div class="py-5 flex flex-col sm:flex-row sm:items-start gap-4">
            <div class="flex items-center gap-3 sm:w-40 shrink-0">
              <span class="text-xs font-mono tracking-widest text-brand-accent font-semibold">STEP {item.step}</span>
              <span class="text-sm font-serif font-medium text-brand-text">{item.title}</span>
            </div>
            <p class="text-xs md:text-sm text-brand-muted tracking-wider leading-relaxed">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Contact CTA -->
    <div class="mt-12 p-8 bg-brand-surface border border-brand-border text-center rounded-sm">
      <h3 class="text-base font-serif font-medium text-brand-text mb-3">
        初回プランのご提案は無料です。ぜひ一度、あなたの夢をお聞かせください。
      </h3>
      <p class="text-xs text-brand-muted tracking-wider mb-6">
        具体的な土地や時期が決まっていなくても大丈夫です。まずはお気軽にご相談ください。
      </p>
      <a
        href="/contact/"
        class="inline-block px-8 py-3 bg-brand-accent hover:bg-brand-dark text-white text-xs tracking-wider rounded font-medium transition shadow-sm"
      >
        家づくりのご相談・お問い合わせ →
      </a>
    </div>
  </div>
</Layout>

