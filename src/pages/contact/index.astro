---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';

const breadcrumbs = [{ name: 'CONTACT' }];
---

<Layout title="CONTACT（お問い合わせ・ご相談） – 株式会社 加藤淳設計事務所">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-4 pb-20">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header -->
    <div class="text-center py-10 md:py-14 border-b border-brand-border mb-8">
      <span class="text-xs font-serif tracking-widest text-brand-accent uppercase block mb-2 font-semibold">Contact</span>
      <h1 class="text-2xl md:text-3xl font-serif tracking-wider text-brand-text mb-4">
        CONTACT（お問い合わせ）
      </h1>
      <p class="text-xs md:text-sm text-brand-muted tracking-wider leading-relaxed max-w-xl mx-auto">
        居心地が良く、住んでいて「楽しい」と感じられる家をつくるため、加藤淳設計事務所ではお客様との対話を大切にしています。具体的な状況が固まっていない段階でも、ぜひお気軽にご相談ください。
      </p>
    </div>

    <!-- Notice Boxes -->
    <div class="space-y-4 mb-10 text-xs tracking-wider leading-relaxed">
      <!-- Notice 1 -->
      <div class="bg-brand-surface border border-brand-border p-5 rounded-sm">
        <h2 class="font-serif font-medium text-brand-text mb-2">見学会ご予約について</h2>
        <ul class="space-y-1 text-brand-muted list-disc list-inside">
          <li>来場希望日・希望時間（10:00～17:00）をメッセージ欄にご明記ください。</li>
          <li>お子様連れのご来場も歓迎いたします（手をつないでの見学をお願いしております）。</li>
          <li>予約状況により、時間調整をお願いする場合がございます。</li>
        </ul>
      </div>

      <!-- Notice 2 -->
      <div class="bg-brand-light/20 border border-brand-accent/40 p-5 text-brand-text rounded-sm">
        <h2 class="font-medium text-brand-text mb-1">■ 携帯メールのドメイン指定受信について</h2>
        <p class="text-brand-muted">
          弊社からのメールは <strong>【@jun-arch.com】</strong> より送信されます。受信許可設定をお願いいたします。
        </p>
      </div>
    </div>


    <!-- Contact Form -->
    <form class="space-y-6 bg-white border border-brand-border p-6 sm:p-10 shadow-sm rounded-sm">
      <!-- Name -->
      <div>
        <label for="name" class="block text-xs font-medium tracking-wider text-brand-text mb-2">
          お名前 <span class="text-red-500 font-normal">※必須</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="例：山田 太郎"
          class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-brand-surface rounded-sm"
        />
      </div>

      <!-- Furigana -->
      <div>
        <label for="name-kana" class="block text-xs font-medium tracking-wider text-brand-text mb-2">
          ふりがな <span class="text-red-500 font-normal">※必須</span>
        </label>
        <input
          type="text"
          id="name-kana"
          name="name-kana"
          required
          placeholder="例：やまだ たろう"
          class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-brand-surface rounded-sm"
        />
      </div>

      <!-- Email -->
      <div>
        <label for="email" class="block text-xs font-medium tracking-wider text-brand-text mb-2">
          Eメールアドレス <span class="text-red-500 font-normal">※必須</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="例：name@example.com"
          class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-brand-surface rounded-sm"
        />
      </div>

      <!-- Phone -->
      <div>
        <label for="tel" class="block text-xs font-medium tracking-wider text-brand-text mb-2">
          お電話番号 <span class="text-red-500 font-normal">※必須</span>
        </label>
        <input
          type="tel"
          id="tel"
          name="tel"
          required
          placeholder="例：090-0000-0000"
          class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-brand-surface rounded-sm"
        />
      </div>

      <!-- Address -->
      <div>
        <label for="address" class="block text-xs font-medium tracking-wider text-brand-text mb-2">
          ご住所 <span class="text-red-500 font-normal">※必須</span>
        </label>
        <input
          type="text"
          id="address"
          name="address"
          required
          placeholder="例：新潟県新潟市中央区..."
          class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-brand-surface rounded-sm"
        />
      </div>

      <!-- Message -->
      <div>
        <label for="message" class="block text-xs font-medium tracking-wider text-brand-text mb-2">
          メッセージ・ご相談内容 <span class="text-red-500 font-normal">※必須</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          placeholder="ご相談内容や見学会のご希望日時をご記入ください"
          class="w-full text-xs sm:text-sm border border-brand-border px-4 py-3 focus:outline-none focus:border-brand-accent transition-colors bg-brand-surface rounded-sm"
        ></textarea>
      </div>

      <!-- Privacy Policy Agreement -->
      <div class="pt-2">
        <label class="flex items-start gap-3 cursor-pointer">
          <input
            type="checkbox"
            required
            class="mt-1 h-4 w-4 border-brand-border text-brand-accent focus:ring-0 cursor-pointer"
          />
          <span class="text-xs text-brand-muted tracking-wider">
            当事務所のプライバシーポリシーをお読みいただき、同意の上で送信してください。
          </span>
        </label>
      </div>

      <!-- Submit Button -->
      <div class="pt-4 text-center">
        <button
          type="submit"
          class="w-full sm:w-auto min-w-[220px] bg-brand-accent hover:bg-brand-dark text-white text-xs tracking-widest px-10 py-4 transition-colors font-medium shadow-sm rounded-sm"
        >
          送信する
        </button>
      </div>
    </form>

  </div>
</Layout>
