---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getOwnerInterviewList } from '../../lib/microcms';

const interviews = await getOwnerInterviewList();

const breadcrumbs = [
  { name: 'オーナーインタビュー' }
];
---

<Layout title="オーナーインタビュー – 株式会社 加藤淳設計事務所" description="加藤淳設計事務所で家を建てられたオーナー様の実際の声と暮らし。心地よい居心地を形にした住まいのインタビュー記事一覧です。">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 pt-4 pb-20">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header -->
    <div class="text-center py-10 md:py-14 border-b border-brand-border mb-12">
      <span class="text-xs font-serif tracking-widest text-brand-accent uppercase block mb-2 font-semibold">Owner Interview</span>
      <h1 class="text-2xl md:text-3xl font-serif tracking-wider text-brand-text mb-4">
        オーナーインタビュー
      </h1>
      <p class="text-xs md:text-sm text-brand-muted tracking-wider max-w-2xl mx-auto leading-relaxed">
        加藤淳設計事務所で家を建てられたオーナー様の実際の声と暮らし。<br class="hidden sm:inline" />
        住まいへの想いや設計の工夫、日々の心地よい居心地のストーリーをお届けします。
      </p>
    </div>

    <!-- Interviews Grid: 3-Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        interviews.map((item) => (
          <article class="group bg-white border border-brand-border rounded overflow-hidden hover:border-brand-accent/60 transition-colors duration-300 flex flex-col">
            <a href={`/owner-interview/${item.id}/`} class="block overflow-hidden aspect-[16/10] bg-transparent relative">
              {item.thumbnail?.url ? (
                <img
                  src={item.thumbnail.url}
                  alt={item.title}
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <img
                  src="/images/noimage.png"
                  alt={item.title}
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  loading="lazy"
                />
              )}
              {item.isExternal ? (
                <span class="absolute top-3 left-3 px-2.5 py-1 text-[11px] font-medium bg-[#ecc58a] text-[#1e1e1e] rounded shadow-sm tracking-wider">
                  メディア取材
                </span>
              ) : (
                <span class="absolute top-3 left-3 px-2.5 py-1 text-[11px] font-medium bg-[#ecc58a] text-[#1e1e1e] rounded shadow-sm tracking-wider">
                  インタビュー
                </span>
              )}
            </a>

            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <time class="block text-xs font-mono text-brand-muted mb-2 tracking-wider">
                  {item.date}
                </time>
                <h2 class="text-sm md:text-base font-serif font-medium text-brand-text leading-snug group-hover:text-brand-accent transition-colors line-clamp-2">
                  <a href={`/owner-interview/${item.id}/`}>
                    {item.title}
                  </a>
                </h2>
              </div>

              <div class="pt-2 border-t border-brand-border/60 flex items-center justify-between text-xs text-brand-accent font-medium tracking-wider">
                <span>記事を読む</span>
                <span class="transform group-hover:translate-x-1 transition-transform duration-200">→</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Back to Top CTA -->
    <div class="text-center pt-16">
      <a
        href="/"
        class="inline-block px-8 py-3 bg-brand-surface hover:bg-brand-light border border-brand-border text-brand-text text-xs tracking-widest rounded font-medium transition shadow-sm"
      >
        ← トップページに戻る
      </a>
    </div>
  </div>
</Layout>

