---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getOwnerInterviewList, getOwnerInterviewDetail } from '../../lib/microcms';

export async function getStaticPaths() {
  const interviewList = await getOwnerInterviewList();
  return interviewList.map((item) => ({
    params: { slug: item.id },
  }));
}

const { slug } = Astro.params;
const interview = await getOwnerInterviewDetail(slug as string);

if (!interview) {
  return Astro.redirect('/owner-interview/');
}

const breadcrumbs = [
  { name: 'オーナーインタビュー', href: '/owner-interview/' },
  { name: interview.title },
];

// サムネイルと本文最初の画像が重複している場合は本文最初を除去
function cleanFirstImageIfDuplicate(content: string, thumbnailUrl?: string): string {
  if (!thumbnailUrl) return content;

  // バナー画像とオリジナル写真の対応マップ
  const BANNER_ORIGIN_MAP: Record<string, string> = {
    'banner-eg-house': 'ehouse-02',
    'banner-f-house': 'fhouse-001',
    'banner-nh-house': 'nhouse-01',
  };

  const normalizeName = (url: string) => {
    const clean = url.split('?')[0].split('#')[0];
    const filename = clean.split('/').pop() || '';
    // リサイズサフィックス（例: -1024x683, -768x512, -scaled 等）を除去して小文字化
    const base = filename
      .replace(/-\d+x\d+(\.[a-zA-Z]+)$/, '$1')
      .replace(/-(?:scaled|rotated)(\.[a-zA-Z]+)$/, '$1')
      .toLowerCase()
      .replace(/\.[a-zA-Z]+$/, '');
    return BANNER_ORIGIN_MAP[base] || base;
  };

  const thumbNorm = normalizeName(thumbnailUrl);

  // 本文中の最初の [[IMG: ...]] を探索
  const imgMatch = content.match(/\[\[IMG:\s*([^\]]+)\]\]/);
  if (imgMatch) {
    const firstImgNorm = normalizeName(imgMatch[1]);
    if (thumbNorm === firstImgNorm || imgMatch[1].trim() === thumbnailUrl.trim()) {
      return content.replace(/<p>\s*\[\[IMG:\s*[^\]]+\]\]\s*<\/p>/, '').replace(/\[\[IMG:\s*[^\]]+\]\]/, '');
    }
  }

  // <img> タグ形式の場合
  const tagMatch = content.match(/<img[^>]+src=["']([^"']+)["']/);
  if (tagMatch) {
    const firstImgNorm = normalizeName(tagMatch[1]);
    if (thumbNorm === firstImgNorm || tagMatch[1].trim() === thumbnailUrl.trim()) {
      return content.replace(/<figure[^>]*>.*?<img[^>]+>.*?<\/figure>/s, '').replace(/<img[^>]+>/, '');
    }
  }

  return content;
}

const cleanedContent = cleanFirstImageIfDuplicate(interview.content, interview.thumbnail?.url);

// 画像プレースホルダー [[IMG: /images/uploads/...]] を figure タグへ自動展開
const renderedContent = cleanedContent.replace(
  /\[\[IMG:\s*([^\]]+)\]\]/g,
  '<figure class="my-8"><img src="$1" alt="" class="w-full h-auto rounded-sm shadow-sm" loading="lazy" /></figure>'
);
---

<Layout title={`${interview.title} – オーナーインタビュー – 株式会社 加藤淳設計事務所`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 pt-4 pb-20">
    <Breadcrumb items={breadcrumbs} />

    <!-- Article Header -->
    <article class="max-w-3xl mx-auto pt-6 pb-12">
      <header class="border-b border-brand-border pb-6 mb-8 space-y-4">
        <div class="flex items-center gap-3 text-xs">
          <span class="text-brand-muted font-mono tracking-wider">{interview.date}</span>
          {
            interview.isExternal ? (
              <span class="px-2.5 py-0.5 bg-[#ecc58a] text-[#1e1e1e] text-[10px] tracking-wider font-medium rounded shadow-sm">
                メディア取材
              </span>
            ) : (
              <span class="px-2.5 py-0.5 bg-[#ecc58a] text-[#1e1e1e] text-[10px] tracking-wider font-medium rounded shadow-sm">
                オーナーインタビュー
              </span>
            )
          }
        </div>
        <h1 class="text-xl sm:text-2xl md:text-3xl font-serif font-medium text-brand-text leading-snug tracking-wider">
          {interview.title}
        </h1>
      </header>

      <!-- Thumbnail -->
      {
        interview.thumbnail?.url && (
          <div class="aspect-[16/10] overflow-hidden rounded-sm bg-white mb-10 border border-brand-border shadow-sm">
            <img
              src={interview.thumbnail.url}
              alt={interview.title}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        )
      }

      <!-- Body Content -->
      <div
        class="interview-content text-xs sm:text-sm text-brand-text leading-[2.2] tracking-wider space-y-6 font-light"
        set:html={renderedContent}
      />

      <!-- External Media Card (新規追加時、本文にカードHTMLが含まれていない場合に自動生成) -->
      {
        interview.externalUrl && !cleanedContent.includes('external-link-card') && (
          <div class="external-link-card my-10 p-6 md:p-8 bg-stone-50 border border-stone-200 rounded text-center">
            <span class="inline-block px-3 py-1 bg-[#ecc58a] text-[#1e1e1e] text-xs font-medium rounded-full mb-3 tracking-wider">
              取材メディア掲載
            </span>
            <h3 class="text-base md:text-lg font-serif font-medium text-stone-800 mb-2">
              {interview.externalUrl.includes('daily-lives-niigata.com') ? 'Daily Lives Niigata' : '取材記事掲載メディア'}
            </h3>
            <p class="text-xs md:text-sm text-stone-600 mb-6">
              {interview.externalUrl.includes('daily-lives-niigata.com')
                ? '新潟の心地いい暮らしを取材・発信するWEBマガジン「Daily Lives Niigata」にて、お施主様のインタビューと住まいの詳しい写真が掲載されています。'
                : '外部メディアにて、お施主様のインタビューと住まいの詳しい様子が取材・紹介されています。'}
            </p>
            <a
              href={interview.externalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-8 py-3.5 bg-stone-900 hover:bg-stone-800 text-white text-xs md:text-sm tracking-widest rounded transition-colors shadow-sm"
            >
              取材記事を読む（外部サイト）
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        )
      }

      <!-- Action Navigation -->
      <div class="pt-12 mt-12 border-t border-brand-border flex flex-col sm:flex-row justify-between items-center gap-4">
        <a
          href="/owner-interview/"
          class="inline-flex items-center gap-2 px-6 py-2.5 bg-brand-surface hover:bg-brand-light border border-brand-border text-brand-text text-xs tracking-wider rounded font-medium transition shadow-sm w-full sm:w-auto justify-center"
        >
          <span>←</span>
          <span>オーナーインタビュー一覧に戻る</span>
        </a>

        <a
          href="/contact/"
          class="inline-flex items-center gap-2 px-6 py-2.5 bg-brand-accent hover:opacity-95 text-white text-xs tracking-wider rounded font-medium transition shadow-sm w-full sm:w-auto justify-center"
        >
          <span>家づくりのご相談・お問い合わせ →</span>
        </a>
      </div>
    </article>
  </div>
</Layout>

<style is:global>
  .interview-content h2,
  .interview-content h3 {
    font-family: var(--font-serif, serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: #1e1e1e;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #e7e5e4;
    line-height: 1.5;
  }

  .interview-content p {
    margin-bottom: 1.5rem;
  }

  .interview-content a:not(.external-link-card a) {
    color: #926118;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .interview-content figure {
    margin: 2rem 0;
  }

  .interview-content figcaption {
    font-size: 0.75rem;
    color: #78716c;
    text-align: center;
    margin-top: 0.5rem;
  }
</style>
